---
import Layout from '../layouts/Layout.astro';
import '../styles/ai-knowledge-platform.css';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
const home = en ? '/en/' : '/';
const alternate = en ? '/projects/ai-knowledge-platform/' : '/en/projects/ai-knowledge-platform/';
const repo = 'https://github.com/matiasaf/ai-knowledge-platform';

const milestones = en ? [
  { number: '01', state: 'DONE', title: 'Trustworthy ingestion', copy: 'Upload, validate, store, and report the only state the backend can actually guarantee.', deliverable: 'PDF + metadata sidecar' },
  { number: '02', state: 'NEXT', title: 'Page-level provenance', copy: 'Extract text without losing the document and page every span came from.', deliverable: 'Text + source coordinates' },
  { number: '03', state: 'PLANNED', title: 'Retrieval before generation', copy: 'Chunk, index, retrieve, and evaluate relevance before adding an LLM answer.', deliverable: 'Measured retrieval' },
  { number: '04', state: 'PLANNED', title: 'Grounded answers', copy: 'Generate answers that point to verifiable passages and fail honestly when evidence is weak.', deliverable: 'Answer + citations' },
  { number: '05', state: 'PLANNED', title: 'Operational visibility', copy: 'Expose latency, tokens, cost, failures, and feedback as part of the product.', deliverable: 'Quality + operations' },
] : [
  { number: '01', state: 'HECHO', title: 'Ingesta confiable', copy: 'Subir, validar, almacenar y comunicar únicamente el estado que el backend puede garantizar.', deliverable: 'PDF + metadata sidecar' },
  { number: '02', state: 'SIGUIENTE', title: 'Provenance por página', copy: 'Extraer texto sin perder el documento y la página de la que salió cada fragmento.', deliverable: 'Texto + coordenadas de origen' },
  { number: '03', state: 'PLANEADO', title: 'Retrieval antes que generación', copy: 'Dividir, indexar, recuperar y evaluar relevancia antes de sumar una respuesta de un LLM.', deliverable: 'Retrieval medido' },
  { number: '04', state: 'PLANEADO', title: 'Respuestas fundamentadas', copy: 'Generar respuestas que apunten a pasajes verificables y fallen con honestidad si la evidencia es débil.', deliverable: 'Respuesta + citas' },
  { number: '05', state: 'PLANEADO', title: 'Visibilidad operativa', copy: 'Exponer latencia, tokens, costo, fallas y feedback como parte del producto.', deliverable: 'Calidad + operación' },
];

const shipped = en ? [
  ['REAL API', 'A focused Next.js upload experience connected to FastAPI.'],
  ['SAFE STREAMING', '10 MB default limit enforced while reading in 64 KiB chunks.'],
  ['TWO CHECKS', 'Declared media type and the PDF file signature must both match.'],
  ['ATOMIC STORAGE', 'Temporary .part files are renamed only after full validation.'],
  ['HONEST STATES', 'The UI models idle, uploading, stored, and error—nothing invented.'],
  ['VERIFIED', 'Backend and frontend tests cover success, rejection, state, and focus behavior.'],
] : [
  ['API REAL', 'Una experiencia de carga enfocada en Next.js, conectada con FastAPI.'],
  ['STREAMING SEGURO', 'Límite de 10 MB aplicado durante la lectura en bloques de 64 KiB.'],
  ['DOBLE VALIDACIÓN', 'Deben coincidir el media type declarado y la firma real del PDF.'],
  ['STORAGE ATÓMICO', 'Los archivos .part se renombran solo después de validar todo el contenido.'],
  ['ESTADOS HONESTOS', 'La UI modela idle, uploading, stored y error: nada inventado.'],
  ['VERIFICADO', 'Los tests cubren éxito, rechazo, estados y comportamiento del foco.'],
];

const t = en ? {
  title: 'AI Knowledge Platform — Build log', description: 'A milestone-by-milestone build log for a document knowledge platform with grounded answers, verifiable citations, and measurable retrieval.',
  back: 'Portfolio', module: 'SIDE PROJECT · BUILD LOG', status: 'MILESTONE 01 COMPLETE', eyebrow: 'AI KNOWLEDGE PLATFORM', heroA: 'Trusted knowledge.', heroB: 'Verifiable answers.', lede: 'Ingest trusted documents, ask questions about them, and get grounded answers with citations—while making retrieval quality, latency, failures, and cost visible.', repo: 'View repository', roadmap: 'See the roadmap', current: 'WHAT EXISTS TODAY', currentStrong: 'Validated PDF ingestion.', currentRest: ' Retrieval, answers, and citations are intentionally not built yet.',
  problemIndex: '01 / THE PROBLEM', problemTitle: 'A fluent answer is not enough.', problemCopy: 'Teams keep real knowledge in policies, contracts, runbooks, and research. An answer only becomes useful when the reader can verify it against the source—and when a retrieval failure stays visible instead of being smoothed over.', principle: 'Evidence before fluency.', principleCopy: 'The project is designed around defensible answers, meaningful states, reproducible evaluation, and observable operation.',
  shippedIndex: '02 / MILESTONE 01', shippedTitle: 'What is working now.', shippedCopy: 'The first vertical slice is deliberately narrow, end to end, tested, and documented.',
  architecture: 'CURRENT ARCHITECTURE', browser: 'Browser', web: 'Next.js web', api: 'FastAPI', storage: 'Local files',
  roadmapIndex: '03 / BUILD PATH', roadmapTitle: 'One trustworthy layer at a time.', roadmapCopy: 'Each milestone creates a working vertical slice. Planned capabilities are visible without being presented as finished.',
  decisionsIndex: '04 / ENGINEERING DECISIONS', decisionsTitle: 'The constraints are part of the story.', d1: 'States mean something', d1c: 'The API reports stored—not ready—because parsing and indexing do not exist yet.', d2: 'Failure leaves no debris', d2c: 'Rejected or interrupted uploads leave neither partial documents nor misleading metadata.', d3: 'Quality before demo polish', d3c: 'Retrieval will be evaluated reproducibly before generation is introduced.',
  close: 'Follow the project as it becomes a system.', closeCopy: 'The repository contains the implementation, tests, architecture decision records, and a progress note for every delivered milestone.', backTop: 'Back to top', footer: 'AI KNOWLEDGE PLATFORM · ACTIVE PROJECT',
} : {
  title: 'AI Knowledge Platform — Paso a paso', description: 'Bitácora milestone a milestone de una plataforma de conocimiento documental con respuestas fundamentadas, citas verificables y retrieval medible.',
  back: 'Portfolio', module: 'SIDE PROJECT · BITÁCORA', status: 'MILESTONE 01 COMPLETO', eyebrow: 'AI KNOWLEDGE PLATFORM', heroA: 'Conocimiento confiable.', heroB: 'Respuestas verificables.', lede: 'Ingerir documentos confiables, hacer preguntas sobre ellos y obtener respuestas fundamentadas con citas, haciendo visibles la calidad de retrieval, la latencia, las fallas y el costo.', repo: 'Abrir repositorio', roadmap: 'Ver el recorrido', current: 'LO QUE EXISTE HOY', currentStrong: 'Ingesta de PDFs validada.', currentRest: ' Retrieval, respuestas y citas todavía no están construidos, a propósito.',
  problemIndex: '01 / EL PROBLEMA', problemTitle: 'Una respuesta fluida no alcanza.', problemCopy: 'Los equipos guardan su conocimiento real en políticas, contratos, runbooks e investigación. Una respuesta se vuelve útil cuando el lector puede verificarla contra la fuente y cuando una falla de retrieval se muestra en vez de disimularse.', principle: 'Evidencia antes que fluidez.', principleCopy: 'El proyecto se diseña alrededor de respuestas defendibles, estados con significado, evaluación reproducible y operación observable.',
  shippedIndex: '02 / MILESTONE 01', shippedTitle: 'Lo que funciona hoy.', shippedCopy: 'El primer vertical slice es deliberadamente acotado, end to end, testeado y documentado.',
  architecture: 'ARQUITECTURA ACTUAL', browser: 'Navegador', web: 'Web Next.js', api: 'FastAPI', storage: 'Archivos locales',
  roadmapIndex: '03 / RECORRIDO', roadmapTitle: 'Una capa confiable a la vez.', roadmapCopy: 'Cada milestone crea un vertical slice funcional. Lo planeado es visible sin presentarlo como terminado.',
  decisionsIndex: '04 / DECISIONES DE INGENIERÍA', decisionsTitle: 'Las restricciones también cuentan la historia.', d1: 'Los estados significan algo', d1c: 'La API informa stored, no ready, porque el parseo y la indexación todavía no existen.', d2: 'Las fallas no dejan residuos', d2c: 'Una carga rechazada o interrumpida no deja documentos parciales ni metadata engañosa.', d3: 'Calidad antes que demo', d3c: 'El retrieval se evaluará de forma reproducible antes de sumar generación.',
  close: 'Seguí el proyecto mientras se convierte en sistema.', closeCopy: 'El repositorio reúne implementación, tests, decisiones de arquitectura y una nota de progreso por cada milestone entregado.', backTop: 'Volver arriba', footer: 'AI KNOWLEDGE PLATFORM · PROYECTO ACTIVO',
};
---

<Layout title={t.title} description={t.description} lang={lang} alternateHref={alternate}>
  <header class="akp-header">
    <a class="akp-brand" href={home} aria-label={en ? 'Back to portfolio' : 'Volver al portfolio'}><span class="brand-monogram">MF</span><span>Matías Fernández <em>/ AI Knowledge Platform</em></span></a>
    <span class="akp-module">{t.module}</span>
    <div class="akp-header-actions"><a href={alternate}>{en ? 'ES' : 'EN'}</a><a href={home}>{t.back} ↗</a></div>
  </header>

  <main id="top" class="akp-page">
    <section class="akp-hero section-shell">
      <div>
        <p class="akp-eyebrow"><span></span>{t.eyebrow}</p>
        <h1>{t.heroA}<br /><em>{t.heroB}</em></h1>
        <p class="akp-lede">{t.lede}</p>
        <div class="akp-actions"><a class="akp-button" href={repo} target="_blank" rel="noreferrer">{t.repo} <span>↗</span></a><a href="#roadmap">{t.roadmap} ↓</a></div>
      </div>
      <aside class="akp-system-card" aria-label={t.architecture}>
        <div class="akp-system-head"><span>{t.architecture}</span><strong>V0.1</strong></div>
        <div class="akp-system-flow"><div><small>01</small><b>{t.browser}</b></div><i>→</i><div><small>02</small><b>{t.web}</b></div><i>→</i><div><small>03</small><b>{t.api}</b></div><i>→</i><div><small>04</small><b>{t.storage}</b></div></div>
        <p><span></span>{t.status}</p>
      </aside>
    </section>

    <section class="akp-truth"><div class="section-shell"><strong>{t.current}</strong><p><b>{t.currentStrong}</b>{t.currentRest}</p></div></section>

    <section class="akp-problem section-shell">
      <p class="akp-index">{t.problemIndex}</p>
      <div><h2>{t.problemTitle}</h2><p>{t.problemCopy}</p></div>
      <aside><strong>{t.principle}</strong><p>{t.principleCopy}</p></aside>
    </section>

    <section class="akp-shipped">
      <div class="section-shell">
        <div class="akp-section-title"><p class="akp-index">{t.shippedIndex}</p><div><h2>{t.shippedTitle}</h2><p>{t.shippedCopy}</p></div></div>
        <div class="akp-shipped-grid">{shipped.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><small>{item[0]}</small><p>{item[1]}</p></article>)}</div>
      </div>
    </section>

    <section class="akp-roadmap section-shell" id="roadmap">
      <div class="akp-section-title"><p class="akp-index">{t.roadmapIndex}</p><div><h2>{t.roadmapTitle}</h2><p>{t.roadmapCopy}</p></div></div>
      <ol class="akp-milestones">{milestones.map((item, index) => <li class:list={{ done: index === 0, next: index === 1 }}><div class="akp-rail"><span>{item.number}</span><i></i></div><article><header><small>{item.state}</small><strong>{item.deliverable}</strong></header><h3>{item.title}</h3><p>{item.copy}</p></article></li>)}</ol>
    </section>

    <section class="akp-decisions">
      <div class="section-shell">
        <div class="akp-section-title light"><p class="akp-index">{t.decisionsIndex}</p><div><h2>{t.decisionsTitle}</h2></div></div>
        <div class="akp-decision-grid"><article><span>01</span><h3>{t.d1}</h3><p>{t.d1c}</p></article><article><span>02</span><h3>{t.d2}</h3><p>{t.d2c}</p></article><article><span>03</span><h3>{t.d3}</h3><p>{t.d3c}</p></article></div>
      </div>
    </section>

    <section class="akp-cta"><div><p>{t.status}</p><h2>{t.close}</h2><p>{t.closeCopy}</p><a class="akp-button" href={repo} target="_blank" rel="noreferrer">GitHub <span>↗</span></a></div></section>
  </main>
  <footer class="akp-footer"><a class="akp-brand" href={home}><span class="brand-monogram">MF</span><span>Matías Fernández</span></a><p>{t.footer}</p><a href="#top">{t.backTop} ↑</a></footer>
</Layout>
