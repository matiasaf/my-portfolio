---
import Layout from '../layouts/Layout.astro';
import '../styles/ai-knowledge-platform.css';
import { aiKnowledgePlatformStatus, routes } from '../content/profile';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
const home = routes[lang].home;
const alternate = en ? '/projects/ai-knowledge-platform/' : '/en/projects/ai-knowledge-platform/';
const repo = aiKnowledgePlatformStatus.repository;
const status = aiKnowledgePlatformStatus.badge[lang];

/* Milestone states mirror the project repository. `IMPLEMENTED` is deliberately
   distinct from `DONE`: milestone 4 runs and passes its provider-independent gates,
   but no model has been selected and no live answer-quality metric is recorded yet. */
const milestones = en ? [
  { number: '01', state: 'DONE', title: 'Trustworthy ingestion', copy: 'Upload, validate, store, and report the only state the backend can actually guarantee.', deliverable: 'PDF + metadata sidecar' },
  { number: '02', state: 'DONE', title: 'Page-level provenance', copy: 'Extract text without losing the document and page every span came from.', deliverable: 'Text + source coordinates' },
  { number: '03', state: 'DONE', title: 'Retrieval before generation', copy: 'Chunk, index, retrieve, and evaluate relevance before adding an LLM answer.', deliverable: 'Measured retrieval' },
  { number: '04', state: 'IMPLEMENTED', title: 'Grounded answers', copy: 'Answers point to verifiable passages and fail honestly when evidence is weak. Implemented and tested; selecting a model and recording live answer quality still requires provider credentials.', deliverable: 'Answer + citations' },
  { number: '05', state: 'PLANNED', title: 'Operational visibility', copy: 'Expose latency, tokens, cost, failures, and feedback as part of the product.', deliverable: 'Quality + operations' },
] : [
  { number: '01', state: 'HECHO', title: 'Ingesta confiable', copy: 'Subir, validar, almacenar y comunicar únicamente el estado que el backend puede garantizar.', deliverable: 'PDF + metadata sidecar' },
  { number: '02', state: 'HECHO', title: 'Provenance por página', copy: 'Extraer texto sin perder el documento y la página de la que salió cada fragmento.', deliverable: 'Texto + coordenadas de origen' },
  { number: '03', state: 'HECHO', title: 'Retrieval antes que generación', copy: 'Dividir, indexar, recuperar y evaluar relevancia antes de sumar una respuesta de un LLM.', deliverable: 'Retrieval medido' },
  { number: '04', state: 'IMPLEMENTADO', title: 'Respuestas fundamentadas', copy: 'Las respuestas apuntan a pasajes verificables y fallan con honestidad si la evidencia es débil. Está implementado y testeado; elegir un modelo y registrar la calidad de respuesta en vivo todavía requiere credenciales del proveedor.', deliverable: 'Respuesta + citas' },
  { number: '05', state: 'PLANEADO', title: 'Visibilidad operativa', copy: 'Exponer latencia, tokens, costo, fallas y feedback como parte del producto.', deliverable: 'Calidad + operación' },
];

const shipped = en ? [
  ['VALIDATED INGESTION', 'The declared media type and the PDF file signature must both match, and a 10 MB limit is enforced while the request streams in 64 KiB chunks.'],
  ['ATOMIC STORAGE', 'Temporary .part files are renamed only after the whole payload validates, so a failure never leaves a partial document behind.'],
  ['PAGE PROVENANCE', 'Every page produces a span with a one-based page number. A textless page is retained as an empty string rather than silently dropped.'],
  ['MEASURED RETRIEVAL', 'Page-bounded chunks in a versioned SQLite database with FTS5/BM25 ranking. Recall@3 and MRR@3 are enforced in CI against a checked-in set.'],
  ['SERVER-RESOLVED CITATIONS', 'The model may reference only request-local evidence IDs; document, page, chunk, and offsets are built from trusted retrieval matches.'],
  ['HONEST OUTCOMES', 'Answered, insufficient-evidence, and safety-refused are distinct states, each rendered as itself instead of a confident sentence.'],
] : [
  ['INGESTA VALIDADA', 'Deben coincidir el media type declarado y la firma real del PDF, y el límite de 10 MB se aplica mientras el request se lee en bloques de 64 KiB.'],
  ['STORAGE ATÓMICO', 'Los archivos .part se renombran solo después de validar todo el contenido, así una falla nunca deja un documento parcial.'],
  ['PROVENANCE POR PÁGINA', 'Cada página produce un span con su número de página en base uno. Una página sin texto se conserva vacía en vez de descartarse en silencio.'],
  ['RETRIEVAL MEDIDO', 'Chunks acotados por página en una base SQLite versionada con ranking FTS5/BM25. Recall@3 y MRR@3 se verifican en CI sobre un set fijo.'],
  ['CITAS RESUELTAS EN EL SERVIDOR', 'El modelo solo puede referenciar IDs de evidencia locales al request; documento, página, chunk y offsets se arman desde matches de retrieval confiables.'],
  ['RESULTADOS HONESTOS', 'Respondido, evidencia insuficiente y rechazo por seguridad son estados distintos, cada uno mostrado como tal y no como una frase segura.'],
];

const t = en ? {
  title: 'AI Knowledge Platform — Build log', description: 'A milestone-by-milestone build log for a document knowledge platform with grounded answers, verifiable citations, and measurable retrieval.',
  back: 'Portfolio', module: 'SIDE PROJECT · BUILD LOG', eyebrow: 'AI KNOWLEDGE PLATFORM', heroA: 'Trusted knowledge.', heroB: 'Verifiable answers.', lede: 'Ingest trusted documents, ask questions about them, and get grounded answers with citations—while making retrieval quality, latency, failures, and cost visible.', repo: 'View repository', roadmap: 'See the roadmap', current: 'WHAT EXISTS TODAY', currentStrong: 'Ingestion, page-level extraction, measured retrieval, and grounded answers run locally.', currentRest: ' Live provider acceptance is pending: no model has been selected and no live answer-quality metric has been recorded yet.',
  problemIndex: '01 / THE PROBLEM', problemTitle: 'A fluent answer is not enough.', problemCopy: 'Teams keep real knowledge in policies, contracts, runbooks, and research. An answer only becomes useful when the reader can verify it against the source—and when a retrieval failure stays visible instead of being smoothed over.', principle: 'Evidence before fluency.', principleCopy: 'The project is designed around defensible answers, meaningful states, reproducible evaluation, and observable operation.',
  shippedIndex: '02 / MILESTONES 01–04', shippedTitle: 'What is working now.', shippedCopy: 'Four vertical slices, each narrow, end to end, tested, and documented. Provider-independent gates pass; live answer quality is not accepted yet.',
  architecture: 'CURRENT ARCHITECTURE', browser: 'Browser', web: 'Next.js web', api: 'FastAPI', index: 'SQLite FTS5 + answers',
  roadmapIndex: '03 / BUILD PATH', roadmapTitle: 'One trustworthy layer at a time.', roadmapCopy: 'Each milestone creates a working vertical slice. Implemented code and accepted quality are shown as different things.',
  decisionsIndex: '04 / ENGINEERING DECISIONS', decisionsTitle: 'The constraints are part of the story.', d1: 'States mean something', d1c: 'Stored, extracted, and indexed are separate states, and each failure state names what can be retried.', d2: 'Failure leaves no debris', d2c: 'Rejected or interrupted uploads leave neither partial documents nor misleading metadata.', d3: 'Quality before demo polish', d3c: 'Retrieval was evaluated reproducibly before generation was introduced, and answer quality has its own versioned dataset.',
  close: 'Follow the project as it becomes a system.', closeCopy: 'The repository contains the implementation, tests, architecture decision records, and a progress note for every delivered milestone.', backTop: 'Back to top', footer: 'AI KNOWLEDGE PLATFORM · ACTIVE PROJECT',
} : {
  title: 'AI Knowledge Platform — Paso a paso', description: 'Bitácora milestone a milestone de una plataforma de conocimiento documental con respuestas fundamentadas, citas verificables y retrieval medible.',
  back: 'Portfolio', module: 'SIDE PROJECT · BITÁCORA', eyebrow: 'AI KNOWLEDGE PLATFORM', heroA: 'Conocimiento confiable.', heroB: 'Respuestas verificables.', lede: 'Ingerir documentos confiables, hacer preguntas sobre ellos y obtener respuestas fundamentadas con citas, haciendo visibles la calidad de retrieval, la latencia, las fallas y el costo.', repo: 'Abrir repositorio', roadmap: 'Ver el recorrido', current: 'LO QUE EXISTE HOY', currentStrong: 'La ingesta, la extracción por página, el retrieval medido y las respuestas fundamentadas funcionan localmente.', currentRest: ' Falta la aceptación con el proveedor en vivo: todavía no se eligió un modelo ni se registraron métricas de calidad de respuesta en vivo.',
  problemIndex: '01 / EL PROBLEMA', problemTitle: 'Una respuesta fluida no alcanza.', problemCopy: 'Los equipos guardan su conocimiento real en políticas, contratos, runbooks e investigación. Una respuesta se vuelve útil cuando el lector puede verificarla contra la fuente y cuando una falla de retrieval se muestra en vez de disimularse.', principle: 'Evidencia antes que fluidez.', principleCopy: 'El proyecto se diseña alrededor de respuestas defendibles, estados con significado, evaluación reproducible y operación observable.',
  shippedIndex: '02 / MILESTONES 01–04', shippedTitle: 'Lo que funciona hoy.', shippedCopy: 'Cuatro vertical slices, cada uno acotado, end to end, testeado y documentado. Los gates independientes del proveedor pasan; la calidad de respuesta en vivo todavía no está aceptada.',
  architecture: 'ARQUITECTURA ACTUAL', browser: 'Navegador', web: 'Web Next.js', api: 'FastAPI', index: 'SQLite FTS5 + respuestas',
  roadmapIndex: '03 / RECORRIDO', roadmapTitle: 'Una capa confiable a la vez.', roadmapCopy: 'Cada milestone crea un vertical slice funcional. El código implementado y la calidad aceptada se muestran como cosas distintas.',
  decisionsIndex: '04 / DECISIONES DE INGENIERÍA', decisionsTitle: 'Las restricciones también cuentan la historia.', d1: 'Los estados significan algo', d1c: 'Stored, extracted e indexed son estados separados, y cada estado de falla dice qué se puede reintentar.', d2: 'Las fallas no dejan residuos', d2c: 'Una carga rechazada o interrumpida no deja documentos parciales ni metadata engañosa.', d3: 'Calidad antes que demo', d3c: 'El retrieval se evaluó de forma reproducible antes de sumar generación, y la calidad de respuesta tiene su propio dataset versionado.',
  close: 'Seguí el proyecto mientras se convierte en sistema.', closeCopy: 'El repositorio reúne implementación, tests, decisiones de arquitectura y una nota de progreso por cada milestone entregado.', backTop: 'Volver arriba', footer: 'AI KNOWLEDGE PLATFORM · PROYECTO ACTIVO',
};
---

<Layout mainId="top" title={t.title} description={t.description} lang={lang} alternateHref={alternate}>
  <header class="akp-header">
    <a class="akp-brand" href={home} aria-label={en ? 'Back to portfolio' : 'Volver al portfolio'}><span class="brand-monogram">MF</span><span>Matías Fernández <em>/ AI Knowledge Platform</em></span></a>
    <span class="akp-module">{t.module}</span>
    <div class="akp-header-actions"><a href={alternate}>{en ? 'ES' : 'EN'}</a><a href={home}>{t.back} ↗</a></div>
  </header>

  <main id="top" tabindex="-1" class="akp-page">
    <section class="akp-hero section-shell">
      <div>
        <p class="akp-eyebrow"><span></span>{t.eyebrow}</p>
        <h1>{t.heroA}<br /><em>{t.heroB}</em></h1>
        <p class="akp-lede">{t.lede}</p>
        <div class="akp-actions"><a class="akp-button" href={repo} target="_blank" rel="noreferrer">{t.repo} <span>↗</span></a><a href="#roadmap">{t.roadmap} ↓</a></div>
      </div>
      <aside class="akp-system-card" aria-label={t.architecture}>
        <div class="akp-system-head"><span>{t.architecture}</span><strong>V0.4</strong></div>
        <div class="akp-system-flow"><div><small>01</small><b>{t.browser}</b></div><i>→</i><div><small>02</small><b>{t.web}</b></div><i>→</i><div><small>03</small><b>{t.api}</b></div><i>→</i><div><small>04</small><b>{t.index}</b></div></div>
        <p><span></span>{status}</p>
      </aside>
    </section>

    <section class="akp-truth"><div class="section-shell"><strong>{t.current}</strong><p><b>{t.currentStrong}</b>{t.currentRest}</p></div></section>

    <section class="akp-problem section-shell">
      <p class="akp-index">{t.problemIndex}</p>
      <div><h2>{t.problemTitle}</h2><p>{t.problemCopy}</p></div>
      <aside><strong>{t.principle}</strong><p>{t.principleCopy}</p></aside>
    </section>

    <section class="akp-shipped">
      <div class="section-shell">
        <div class="akp-section-title"><p class="akp-index">{t.shippedIndex}</p><div><h2>{t.shippedTitle}</h2><p>{t.shippedCopy}</p></div></div>
        <div class="akp-shipped-grid">{shipped.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><small>{item[0]}</small><p>{item[1]}</p></article>)}</div>
      </div>
    </section>

    <section class="akp-roadmap section-shell" id="roadmap">
      <div class="akp-section-title"><p class="akp-index">{t.roadmapIndex}</p><div><h2>{t.roadmapTitle}</h2><p>{t.roadmapCopy}</p></div></div>
      <ol class="akp-milestones">{milestones.map((item, index) => <li class:list={{ done: index < 3, next: index === 3 }}><div class="akp-rail"><span>{item.number}</span><i></i></div><article><header><small>{item.state}</small><strong>{item.deliverable}</strong></header><h3>{item.title}</h3><p>{item.copy}</p></article></li>)}</ol>
    </section>

    <section class="akp-decisions">
      <div class="section-shell">
        <div class="akp-section-title light"><p class="akp-index">{t.decisionsIndex}</p><div><h2>{t.decisionsTitle}</h2></div></div>
        <div class="akp-decision-grid"><article><span>01</span><h3>{t.d1}</h3><p>{t.d1c}</p></article><article><span>02</span><h3>{t.d2}</h3><p>{t.d2c}</p></article><article><span>03</span><h3>{t.d3}</h3><p>{t.d3c}</p></article></div>
      </div>
    </section>

    <section class="akp-cta"><div><p>{status}</p><h2>{t.close}</h2><p>{t.closeCopy}</p><a class="akp-button" href={repo} target="_blank" rel="noreferrer">GitHub <span>↗</span></a></div></section>
  </main>
  <footer class="akp-footer"><a class="akp-brand" href={home}><span class="brand-monogram">MF</span><span>Matías Fernández</span></a><p>{t.footer}</p><a href="#top">{t.backTop} ↑</a></footer>
</Layout>
