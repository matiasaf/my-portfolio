---
import Layout from '../layouts/Layout.astro';
import PixelWordmark from './PixelWordmark.astro';
import WritingSidebar from './WritingSidebar.astro';
import '../styles/portfolio.css';
import { notes as allNotes } from '../content/notes';
import { contactLinks, navigation, routes } from '../content/profile';
import { aiKnowledgePlatformStatus } from '../content/work';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
const route = routes[lang];
const alternatePath = en ? routes.es.writing : routes.en.writing;
const aboutPath = route.about;
const newTab = en ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)';
const nav = navigation(lang);

const socialLinks = {
  github: contactLinks.github,
  email: contactLinks.email,
};

const notes = allNotes[lang];

const projects = en ? [
  {
    number: '01', title: 'AI Knowledge Platform', label: 'APPLIED AI · RAG', status: aiKnowledgePlatformStatus.progress.en, tone: 'coral',
    copy: 'A document knowledge platform built in public, with verifiable ingestion, measured retrieval, grounded answers with citations, and observability as product surfaces.',
    href: '/en/work/ai-knowledge-platform/', cta: 'Read the case study', stack: ['Python', 'RAG', 'Product'],
  },
] : [
  {
    number: '01', title: 'AI Knowledge Platform', label: 'APPLIED AI · RAG', status: aiKnowledgePlatformStatus.progress.es, tone: 'coral',
    copy: 'Una plataforma de conocimiento documental construida en público, con ingesta verificable, retrieval medido, respuestas fundamentadas con citas y observabilidad como superficies de producto.',
    href: '/es/trabajo/ai-knowledge-platform/', cta: 'Leer el caso de estudio', stack: ['Python', 'RAG', 'Producto'],
  },
];

const series = en ? [
  {
    number: '01', label: 'AI · LEARNING IN PUBLIC', title: 'AI & Harnesses',
    description: 'How language models work, what has to be built around them to make a product, and which ideas survive contact with production.',
    href: '/ai/', cta: 'Explore the series', accent: 'coral', status: 'In progress', diagram: ['Tokens', 'Attention', 'Harness'],
  },
  {
    number: '02', label: 'ARCHITECTURE · FOUNDATIONS', title: 'System Design',
    description: 'A visual guide to the decisions, trade-offs, and patterns behind systems designed to grow.',
    href: '/system-design/', cta: 'Open the guide', accent: 'blue', status: 'Visual guide', diagram: ['Question', 'Trade-off', 'Design'],
  },
] : [
  {
    number: '01', label: 'AI · APRENDIZAJE EN PÚBLICO', title: 'AI & Harnesses',
    description: 'Cómo funcionan los modelos de lenguaje, qué hay que construir alrededor para convertirlos en producto y qué ideas sobreviven a producción.',
    href: '/ai/', cta: 'Explorar la serie', accent: 'coral', status: 'En construcción', diagram: ['Tokens', 'Attention', 'Harness'],
  },
  {
    number: '02', label: 'ARQUITECTURA · FUNDAMENTOS', title: 'System Design',
    description: 'Una guía visual sobre decisiones, trade-offs y patrones para diseñar sistemas que puedan crecer.',
    href: '/system-design/', cta: 'Entrar a la guía', accent: 'blue', status: 'Guía visual', diagram: ['Pregunta', 'Trade-off', 'Diseño'],
  },
];

const t = en ? {
  title: 'Writing — Matías Fernández',
  description: 'Technical notes, visual guides, and an active side project about applied AI, system design, data, and building software products.',
  nav: 'Main navigation', notes: 'Notes', projects: 'Projects', series: 'Series', about: 'About me', home: 'Back to the home page',
  kicker: 'TECHNICAL NOTES · ACTIVE PROJECT · LEARNING IN PUBLIC',
  summary: 'A working notebook about applied AI, system design, data, and product engineering. I publish what I learn and show the artifacts I build along the way.',
  read: 'Start reading', explore: 'See the project', board: 'Map of published work', boardTop: 'PUBLISHED / IN PROGRESS', boardNote: 'notes + diagrams + working software',
  strip: 'CURRENT THREADS', notesIndex: '01 / LATEST NOTES', notesTitle: 'Start with an idea.', edition: 'READING LIST 001',
  projectsIndex: '02 / ACTIVE PROJECT', projectsA: 'One active build.', projectsB: 'Evidence you can inspect.', projectsCopy: 'AI Knowledge Platform is the only side project featured here: an active public build with source, tests, retrieval evaluation, and an explicit delivery state.',
  seriesIndex: '03 / SERIES & GUIDES', seriesA: 'Ideas that need', seriesB: 'more than one post.', seriesCopy: 'Longer learning paths that connect concepts, decisions, and implementation.',
  aboutIndex: '04 / ABOUT ME', aboutA: 'The work is here.', aboutB: 'The résumé is elsewhere.', aboutCopy: 'I’m Matías, a senior full-stack engineer based in Argentina. If you want the professional timeline, current client work, toolbox, and résumé, they live in a separate section.', aboutCta: 'Go to About me',
  contactKicker: 'ARGENTINA · OPEN TO CONVERSATION', contactA: 'Have an idea', contactB: 'worth exploring?', contactCopy: 'Tell me about a system, an article, or a side project that would be interesting to think through together.', email: 'Send an email', footer: 'Published while building.',
} : {
  title: 'Publicaciones — Matías Fernández',
  description: 'Notas técnicas, guías visuales y un side project activo sobre AI aplicada, system design, datos y construcción de productos de software.',
  nav: 'Navegación principal', notes: 'Posteos', projects: 'Proyectos', series: 'Series', about: 'Sobre mí', home: 'Volver al inicio',
  kicker: 'NOTAS TÉCNICAS · PROYECTO ACTIVO · APRENDER EN PÚBLICO',
  summary: 'Una bitácora de trabajo sobre AI aplicada, system design, datos e ingeniería de producto. Publico lo que aprendo y muestro los artefactos que construyo en el camino.',
  read: 'Empezar a leer', explore: 'Ver el proyecto', board: 'Mapa de trabajo publicado', boardTop: 'PUBLICADO / EN PROCESO', boardNote: 'notas + diagramas + software funcionando',
  strip: 'HILOS ABIERTOS', notesIndex: '01 / ÚLTIMOS POSTEOS', notesTitle: 'Empezá por una idea.', edition: 'LISTA DE LECTURA 001',
  projectsIndex: '02 / PROYECTO ACTIVO', projectsA: 'Uno en marcha.', projectsB: 'Evidencia que podés revisar.', projectsCopy: 'AI Knowledge Platform es el único side project destacado acá: un producto público activo con código, tests, evaluación de retrieval y estado de entrega explícito.',
  seriesIndex: '03 / SERIES & GUÍAS', seriesA: 'Ideas que necesitan', seriesB: 'más de un posteo.', seriesCopy: 'Recorridos de aprendizaje largos que conectan conceptos, decisiones e implementación.',
  aboutIndex: '04 / SOBRE MÍ', aboutA: 'El trabajo está acá.', aboutB: 'El CV, en otro lado.', aboutCopy: 'Soy Matías, senior full-stack engineer desde Argentina. Si buscás la cronología profesional, el trabajo actual, las herramientas y el CV, viven en una sección separada.', aboutCta: 'Ir a Sobre mí',
  contactKicker: 'ARGENTINA · ABIERTO A CONVERSAR', contactA: '¿Tenés una idea', contactB: 'que valga la pena explorar?', contactCopy: 'Contame sobre un sistema, un posteo o un side project que estaría bueno pensar juntos.', email: 'Enviar un email', footer: 'Publicado mientras construyo.',
};
---

<Layout title={t.title} description={t.description} lang={lang} alternateHref={alternatePath} mainId="inicio">
  <header class="portfolio-header" data-portfolio-header>
    <a class="portfolio-brand" href={route.home} aria-label={en ? 'Matías Fernández, home' : 'Matías Fernández, inicio'}>
      <PixelWordmark compact />
    </a>

    <nav aria-label={t.nav}>
      {nav.map((item) => (
        <a href={item.href} aria-current={item.href === route.writing ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="portfolio-header-actions">
      <nav class="language-switcher" aria-label={en ? 'Choose language' : 'Elegir idioma'}>
        <a href={routes.es.writing} lang="es" hreflang="es" aria-current={!en ? 'page' : undefined}>ES</a>
        <a href={routes.en.writing} lang="en" hreflang="en" aria-current={en ? 'page' : undefined}>EN</a>
      </nav>
      <a class="header-note" href={route.home}>{t.home} <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <WritingSidebar {lang} />

  <main id="inicio" tabindex="-1" class="portfolio-main editorial-home has-writing-sidebar">
    <section class="portfolio-hero portfolio-shell editorial-hero">
      <div class="hero-intro">
        <p class="portfolio-kicker"><span></span> {t.kicker}</p>
        {en
          ? <h1>I write to learn.<br /><em>I build</em> to understand.</h1>
          : <h1>Escribo para aprender.<br /><em>Construyo</em> para entender.</h1>}
        <p class="hero-summary">{t.summary}</p>
        <div class="portfolio-actions">
          <a class="primary-action" href="#notes">{t.read} <span aria-hidden="true">↓</span></a>
          <a class="quiet-action" href="#projects">{t.explore} <span aria-hidden="true">→</span></a>
        </div>
        <ul class="hero-proof" aria-label={en ? 'Published work summary' : 'Resumen de trabajo publicado'}>
          <li><strong>{String(notes.length).padStart(2, '0')}</strong><span>{en ? 'notes to read now' : 'posteos para leer ahora'}</span></li>
          <li><strong>01</strong><span>{en ? 'active public project' : 'proyecto público activo'}</span></li>
          <li><strong>02</strong><span>{en ? 'growing visual series' : 'series visuales creciendo'}</span></li>
        </ul>
      </div>

      <aside class="hero-index" aria-label={t.board}>
        <header>
          <span>{t.boardTop}</span>
          <p>{t.boardNote}</p>
        </header>
        <nav aria-label={en ? 'Browse by topic' : 'Explorar por tema'}>
          <a href="/ai/"><span>01</span><strong>AI & Harnesses</strong><small>Models · Tools · Evals</small><b aria-hidden="true">→</b></a>
          <a href="/system-design/"><span>02</span><strong>System Design</strong><small>Trade-offs · Data · Scale</small><b aria-hidden="true">→</b></a>
          <a href="#projects"><span>03</span><strong>{en ? 'Active project' : 'Proyecto activo'}</strong><small>Code · Evidence · Notes</small><b aria-hidden="true">↓</b></a>
        </nav>
      </aside>
    </section>

    <section class="notes-section portfolio-shell home-notes" id="notes" aria-labelledby="notes-title">
      <div class="notes-title-row">
        <div><p class="section-index">{t.notesIndex}</p><h2 id="notes-title">{t.notesTitle}</h2></div>
        <span class="edition">{t.edition}</span>
      </div>
      <div class="note-list">
        {notes.map((note, index) => (
          <a href={note.href}>
            <span class="note-number">0{index + 1}</span>
            <div><small>{note.tag} · {note.meta}</small><h3>{note.title}</h3></div>
            <span class="note-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-projects" id="projects">
      <div class="portfolio-shell">
        <div class="home-section-heading">
          <div><p class="section-index">{t.projectsIndex}</p><h2>{t.projectsA}<br /><em>{t.projectsB}</em></h2></div>
          <p>{t.projectsCopy}</p>
        </div>
        <div class="side-project-grid is-single">
          {projects.map((project) => (
            <article class={`side-project-card side-project-${project.tone} is-active`}>
              <div class="side-project-top"><span>{project.number}</span><small>{project.status}</small></div>
              <p class="side-project-label">{project.label}</p>
              <h3>{project.title}</h3>
              <p class="side-project-copy">{project.copy}</p>
              <ul>{project.stack.map((item) => <li>{item}</li>)}</ul>
              <a class="side-project-link" href={project.href}>{project.cta} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="archive-section" id="series">
      <div class="portfolio-shell">
        <div class="section-heading">
          <div><p class="section-index">{t.seriesIndex}</p><h2>{t.seriesA}<br /><em>{t.seriesB}</em></h2></div>
          <p>{t.seriesCopy}</p>
        </div>
        <div class="module-grid">
          {series.map((item) => (
            <a class={`module-card accent-${item.accent}`} href={item.href}>
              <div class="module-top"><span>{item.number}</span><small>{item.status}</small></div>
              <p class="module-label">{item.label}</p><h3>{item.title}</h3><p class="module-description">{item.description}</p>
              <div class="module-diagram" aria-hidden="true">
                {item.diagram.map((part, index) => <><span>{part}</span>{index < item.diagram.length - 1 && <i>→</i>}</>)}
              </div>
              <div class="module-link">{item.cta} <span aria-hidden="true">↗</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-about portfolio-shell">
      <p class="section-index">{t.aboutIndex}</p>
      <div><h2>{t.aboutA}<br /><em>{t.aboutB}</em></h2><p>{t.aboutCopy}</p></div>
      <a href={aboutPath}>{t.aboutCta} <span aria-hidden="true">→</span></a>
    </section>

    <section class="contact-section editorial-contact" id="contact">
      <div class="contact-rings" aria-hidden="true"></div>
      <div class="contact-content">
        <p class="portfolio-kicker"><span></span> {t.contactKicker}</p>
        <h2>{t.contactA}<br /><em>{t.contactB}</em></h2>
        <p>{t.contactCopy}</p>
        <div class="contact-links">
          <a href={socialLinks.email}>{t.email} <span aria-hidden="true">↗</span></a>
          <a href={socialLinks.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span><span class="visually-hidden">{newTab}</span></a>
          <a href={aboutPath}>{t.about} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="portfolio-footer">
    <a class="portfolio-brand" href={route.home}><PixelWordmark compact /></a>
    <p>{en ? 'Notes · Active project · Systems' : 'Posteos · Proyecto activo · Sistemas'}</p><span>{t.footer}</span>
  </footer>

  <script>
    const header = document.querySelector('[data-portfolio-header]');
    const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 20);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  </script>
</Layout>
