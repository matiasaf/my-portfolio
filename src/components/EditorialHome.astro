---
import Layout from '../layouts/Layout.astro';
import '../styles/portfolio.css';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
const alternatePath = en ? '/' : '/en/';
const aboutPath = en ? '/en/about/' : '/sobre-mi/';
const newTab = en ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)';

const socialLinks = {
  github: 'https://github.com/matiasaf',
  email: 'mailto:fernandez.amatias@gmail.com',
};

const notes = en ? [
  { tag: 'DATABASES', meta: 'SYSTEM DESIGN · BILINGUAL', title: 'Choosing a database: design from questions, not logos', href: '/en/system-design/choosing-a-database/' },
  { tag: 'PYTHON', meta: 'SYSTEM DESIGN · SPANISH', title: 'Concurrency vs. parallelism: how to choose and design the system', href: '/system-design/concurrencia-vs-paralelismo-python/' },
  { tag: 'AI', meta: 'ARTICLE 01', title: 'Inside a transformer: from a token to the next token', href: '/ai/transformer-architecture/' },
  { tag: 'SYSTEM DESIGN', meta: 'FOUNDATIONS', title: 'Building means choosing: an introduction to trade-offs', href: '/system-design/#tradeoffs' },
  { tag: 'DDIA', meta: 'BOOK NOTES', title: 'Reliable, scalable, and maintainable applications', href: '/system-design/ddia/chapter-01/' },
] : [
  { tag: 'BASES DE DATOS', meta: 'SYSTEM DESIGN · BILINGÜE', title: 'Elegir una base de datos: diseñá desde las preguntas, no desde el logo', href: '/system-design/elegir-base-de-datos/' },
  { tag: 'PYTHON', meta: 'SYSTEM DESIGN · ARTÍCULO 01', title: 'Concurrencia vs. paralelismo: cómo elegir y diseñar el sistema', href: '/system-design/concurrencia-vs-paralelismo-python/' },
  { tag: 'AI', meta: 'ARTÍCULO 01', title: 'Inside a transformer: de un token al siguiente token', href: '/ai/transformer-architecture/' },
  { tag: 'SYSTEM DESIGN', meta: 'FUNDAMENTOS', title: 'Construir es elegir: una introducción a los trade-offs', href: '/system-design/#tradeoffs' },
  { tag: 'DDIA', meta: 'NOTAS DEL LIBRO', title: 'Reliable, scalable, and maintainable applications', href: '/system-design/ddia/chapter-01/' },
];

const projects = en ? [
  {
    number: '01', title: 'AI Knowledge Platform', label: 'APPLIED AI · RAG', status: '1 / 5 milestones', tone: 'coral',
    copy: 'A document knowledge platform built in public, with verifiable ingestion, retrieval evaluation, grounded answers, and observability as product surfaces.',
    href: '/en/projects/ai-knowledge-platform/', cta: 'Read the build log', stack: ['Python', 'RAG', 'Product'],
  },
  {
    number: '02', title: 'Agent Harness Lab', label: 'AGENTS · ORCHESTRATION', status: 'Queued', tone: 'blue',
    copy: 'A minimal harness for running an agent with explicit state, tool permissions, retries, budgets, traces, and human checkpoints.',
    cta: 'Roadmap coming soon', stack: ['Python', 'Agents', 'Tracing'],
  },
  {
    number: '03', title: 'RAG Evaluation Workbench', label: 'EVALS · RETRIEVAL', status: 'Queued', tone: 'lime',
    copy: 'A small evaluation workbench for comparing chunking, retrieval, reranking, groundedness, citations, latency, and cost against a fixed dataset.',
    cta: 'Roadmap coming soon', stack: ['Evals', 'RAG', 'Observability'],
  },
  {
    number: '04', title: 'Tool-Calling Sandbox', label: 'TOOLS · MCP · SAFETY', status: 'Queued', tone: 'violet',
    copy: 'A controlled environment for testing tool schemas, approval boundaries, failure recovery, and the difference between a model response and a reliable action.',
    cta: 'Roadmap coming soon', stack: ['MCP', 'Tool use', 'Guardrails'],
  },
] : [
  {
    number: '01', title: 'AI Knowledge Platform', label: 'APPLIED AI · RAG', status: '1 / 5 milestones', tone: 'coral',
    copy: 'Una plataforma de conocimiento documental construida en público, con ingesta verificable, evaluación de retrieval, respuestas con citas y observabilidad como superficies de producto.',
    href: '/projects/ai-knowledge-platform/', cta: 'Ver el paso a paso', stack: ['Python', 'RAG', 'Producto'],
  },
  {
    number: '02', title: 'Agent Harness Lab', label: 'AGENTES · ORQUESTACIÓN', status: 'En cola', tone: 'blue',
    copy: 'Un harness mínimo para ejecutar un agente con estado explícito, permisos de herramientas, reintentos, presupuestos, trazas y checkpoints humanos.',
    cta: 'Roadmap próximamente', stack: ['Python', 'Agentes', 'Tracing'],
  },
  {
    number: '03', title: 'RAG Evaluation Workbench', label: 'EVALS · RETRIEVAL', status: 'En cola', tone: 'lime',
    copy: 'Un banco de evaluación para comparar chunking, retrieval, reranking, groundedness, citas, latencia y costo sobre un dataset fijo.',
    cta: 'Roadmap próximamente', stack: ['Evals', 'RAG', 'Observabilidad'],
  },
  {
    number: '04', title: 'Tool-Calling Sandbox', label: 'TOOLS · MCP · SEGURIDAD', status: 'En cola', tone: 'violet',
    copy: 'Un entorno controlado para probar schemas de herramientas, límites de aprobación, recuperación de fallos y la distancia entre responder y ejecutar una acción confiable.',
    cta: 'Roadmap próximamente', stack: ['MCP', 'Tool use', 'Guardrails'],
  },
];

const series = en ? [
  {
    number: '01', label: 'AI · LEARNING IN PUBLIC', title: 'AI & Harnesses',
    description: 'How language models work, what has to be built around them to make a product, and which ideas survive contact with production.',
    href: '/ai/', cta: 'Explore the series', accent: 'coral', status: 'In progress', diagram: ['Tokens', 'Attention', 'Harness'],
  },
  {
    number: '02', label: 'ARCHITECTURE · FOUNDATIONS', title: 'System Design',
    description: 'A visual guide to the decisions, trade-offs, and patterns behind systems designed to grow.',
    href: '/system-design/', cta: 'Open the guide', accent: 'blue', status: 'Visual guide', diagram: ['Question', 'Trade-off', 'Design'],
  },
] : [
  {
    number: '01', label: 'AI · APRENDIZAJE EN PÚBLICO', title: 'AI & Harnesses',
    description: 'Cómo funcionan los modelos de lenguaje, qué hay que construir alrededor para convertirlos en producto y qué ideas sobreviven a producción.',
    href: '/ai/', cta: 'Explorar la serie', accent: 'coral', status: 'En construcción', diagram: ['Tokens', 'Attention', 'Harness'],
  },
  {
    number: '02', label: 'ARQUITECTURA · FUNDAMENTOS', title: 'System Design',
    description: 'Una guía visual sobre decisiones, trade-offs y patrones para diseñar sistemas que puedan crecer.',
    href: '/system-design/', cta: 'Entrar a la guía', accent: 'blue', status: 'Guía visual', diagram: ['Pregunta', 'Trade-off', 'Diseño'],
  },
];

const t = en ? {
  title: 'Matías Fernández — Notes and side projects',
  description: 'Technical notes, visual guides, and side projects about applied AI, system design, data, and building software products.',
  nav: 'Main navigation', notes: 'Notes', projects: 'Projects', series: 'Series', about: 'About me',
  kicker: 'TECHNICAL NOTES · SIDE PROJECTS · LEARNING IN PUBLIC',
  summary: 'A working notebook about applied AI, system design, data, and product engineering. I publish what I learn and show the artifacts I build along the way.',
  read: 'Start reading', explore: 'See the projects', board: 'Map of published work', boardTop: 'PUBLISHED / IN PROGRESS', boardNote: 'notes + diagrams + working software',
  strip: 'CURRENT THREADS', notesIndex: '01 / LATEST NOTES', notesTitle: 'Start with an idea.', edition: 'READING LIST 001',
  projectsIndex: '02 / SIDE PROJECTS', projectsA: 'One active build.', projectsB: 'Three experiments queued.', projectsCopy: 'A public backlog focused on AI products and agent harnesses. The first project is underway; the next three make the questions we will explore next explicit.',
  seriesIndex: '03 / SERIES & GUIDES', seriesA: 'Ideas that need', seriesB: 'more than one post.', seriesCopy: 'Longer learning paths that connect concepts, decisions, and implementation.',
  aboutIndex: '04 / ABOUT ME', aboutA: 'The work is here.', aboutB: 'The résumé is elsewhere.', aboutCopy: 'I’m Matías, a senior full-stack engineer based in Argentina. If you want the professional timeline, current client work, toolbox, and résumé, they live in a separate section.', aboutCta: 'Go to About me',
  contactKicker: 'ARGENTINA · OPEN TO CONVERSATION', contactA: 'Have an idea', contactB: 'worth exploring?', contactCopy: 'Tell me about a system, an article, or a side project that would be interesting to think through together.', email: 'Send an email', footer: 'Published while building.',
} : {
  title: 'Matías Fernández — Notas y side projects',
  description: 'Notas técnicas, guías visuales y side projects sobre AI aplicada, system design, datos y construcción de productos de software.',
  nav: 'Navegación principal', notes: 'Posteos', projects: 'Proyectos', series: 'Series', about: 'Sobre mí',
  kicker: 'NOTAS TÉCNICAS · SIDE PROJECTS · APRENDER EN PÚBLICO',
  summary: 'Una bitácora de trabajo sobre AI aplicada, system design, datos e ingeniería de producto. Publico lo que aprendo y muestro los artefactos que construyo en el camino.',
  read: 'Empezar a leer', explore: 'Ver los proyectos', board: 'Mapa de trabajo publicado', boardTop: 'PUBLICADO / EN PROCESO', boardNote: 'notas + diagramas + software funcionando',
  strip: 'HILOS ABIERTOS', notesIndex: '01 / ÚLTIMOS POSTEOS', notesTitle: 'Empezá por una idea.', edition: 'LISTA DE LECTURA 001',
  projectsIndex: '02 / SIDE PROJECTS', projectsA: 'Uno en marcha.', projectsB: 'Tres experimentos en cola.', projectsCopy: 'Un backlog público enfocado en productos de AI y agent harnesses. El primer proyecto está en desarrollo; los otros tres hacen explícitas las preguntas que vamos a explorar después.',
  seriesIndex: '03 / SERIES & GUÍAS', seriesA: 'Ideas que necesitan', seriesB: 'más de un posteo.', seriesCopy: 'Recorridos de aprendizaje largos que conectan conceptos, decisiones e implementación.',
  aboutIndex: '04 / SOBRE MÍ', aboutA: 'El trabajo está acá.', aboutB: 'El CV, en otro lado.', aboutCopy: 'Soy Matías, senior full-stack engineer desde Argentina. Si buscás la cronología profesional, el trabajo actual, las herramientas y el CV, viven en una sección separada.', aboutCta: 'Ir a Sobre mí',
  contactKicker: 'ARGENTINA · ABIERTO A CONVERSAR', contactA: '¿Tenés una idea', contactB: 'que valga la pena explorar?', contactCopy: 'Contame sobre un sistema, un posteo o un side project que estaría bueno pensar juntos.', email: 'Enviar un email', footer: 'Publicado mientras construyo.',
};
---

<Layout title={t.title} description={t.description} lang={lang} alternateHref={alternatePath} mainId="inicio">
  <header class="portfolio-header" data-portfolio-header>
    <a class="portfolio-brand" href="#inicio" aria-label={en ? 'Matías Fernández, home' : 'Matías Fernández, inicio'}>
      <span class="brand-monogram" aria-hidden="true">MF</span>
      <span>Matías Fernández</span>
    </a>

    <nav aria-label={t.nav}>
      <a href="#notes">{t.notes}</a>
      <a href="#projects">{t.projects}</a>
      <a href="#series">{t.series}</a>
      <a href={aboutPath}>{t.about}</a>
    </nav>

    <div class="portfolio-header-actions">
      <nav class="language-switcher" aria-label={en ? 'Choose language' : 'Elegir idioma'}>
        <a href="/" lang="es" hreflang="es" aria-current={!en ? 'page' : undefined}>ES</a>
        <a href="/en/" lang="en" hreflang="en" aria-current={en ? 'page' : undefined}>EN</a>
      </nav>
      <a class="header-note" href={aboutPath}>{t.about} <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <main id="inicio" tabindex="-1" class="portfolio-main editorial-home">
    <section class="portfolio-hero portfolio-shell editorial-hero">
      <div class="hero-intro">
        <p class="portfolio-kicker"><span></span> {t.kicker}</p>
        {en
          ? <h1>I write to learn.<br /><em>I build</em> to understand.</h1>
          : <h1>Escribo para aprender.<br /><em>Construyo</em> para entender.</h1>}
        <p class="hero-summary">{t.summary}</p>
        <div class="portfolio-actions">
          <a class="primary-action" href="#notes">{t.read} <span aria-hidden="true">↓</span></a>
          <a class="quiet-action" href="#projects">{t.explore} <span aria-hidden="true">→</span></a>
        </div>
        <ul class="hero-proof" aria-label={en ? 'Published work summary' : 'Resumen de trabajo publicado'}>
          <li><strong>05</strong><span>{en ? 'notes to read now' : 'posteos para leer ahora'}</span></li>
          <li><strong>1+3</strong><span>{en ? 'active + queued projects' : 'proyecto activo + tres en cola'}</span></li>
          <li><strong>02</strong><span>{en ? 'growing visual series' : 'series visuales creciendo'}</span></li>
        </ul>
      </div>

      <div class="hero-board" role="group" aria-label={t.board}>
        <div class="board-grid" aria-hidden="true"></div>
        <div class="board-label board-label-top">{t.boardTop}</div>
        <div class="topic-orbit"><div class="topic-core"><span>LEARN</span><strong>in public</strong></div></div>
        <a class="topic-card topic-data" href="/ai/"><span>01</span><strong>AI</strong><small>Models · Harnesses ↗</small></a>
        <a class="topic-card topic-systems" href="/system-design/"><span>02</span><strong>Systems</strong><small>Trade-offs · Scale ↗</small></a>
        <a class="topic-card topic-interface" href="#projects"><span>03</span><strong>{en ? 'Builds' : 'Proyectos'}</strong><small>Code · Evidence ↗</small></a>
        <div class="board-note">{t.boardNote}</div>
      </div>
    </section>

    <section class="now-strip" aria-label={t.strip}>
      <span>{t.strip}</span><p>Applied AI</p><i aria-hidden="true">✦</i><p>Agent harnesses</p><i aria-hidden="true">✦</i><p>RAG & evals</p><i aria-hidden="true">✦</i><p>Tool use</p>
    </section>

    <section class="notes-section portfolio-shell home-notes" id="notes" aria-labelledby="notes-title">
      <div class="notes-title-row">
        <div><p class="section-index">{t.notesIndex}</p><h2 id="notes-title">{t.notesTitle}</h2></div>
        <span class="edition">{t.edition}</span>
      </div>
      <div class="note-list">
        {notes.map((note, index) => (
          <a href={note.href}>
            <span class="note-number">0{index + 1}</span>
            <div><small>{note.tag} · {note.meta}</small><h3>{note.title}</h3></div>
            <span class="note-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-projects" id="projects">
      <div class="portfolio-shell">
        <div class="home-section-heading">
          <div><p class="section-index">{t.projectsIndex}</p><h2>{t.projectsA}<br /><em>{t.projectsB}</em></h2></div>
          <p>{t.projectsCopy}</p>
        </div>
        <div class="side-project-grid">
          {projects.map((project) => (
            <article class={`side-project-card side-project-${project.tone} ${project.href ? 'is-active' : 'is-planned'}`}>
              <div class="side-project-top"><span>{project.number}</span><small>{project.status}</small></div>
              <p class="side-project-label">{project.label}</p>
              <h3>{project.title}</h3>
              <p class="side-project-copy">{project.copy}</p>
              <ul>{project.stack.map((item) => <li>{item}</li>)}</ul>
              {project.href
                ? <a class="side-project-link" href={project.href}>{project.cta} <span aria-hidden="true">↗</span></a>
                : <p class="side-project-link planned-label">{project.cta} <span aria-hidden="true">○</span></p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="archive-section" id="series">
      <div class="portfolio-shell">
        <div class="section-heading">
          <div><p class="section-index">{t.seriesIndex}</p><h2>{t.seriesA}<br /><em>{t.seriesB}</em></h2></div>
          <p>{t.seriesCopy}</p>
        </div>
        <div class="module-grid">
          {series.map((item) => (
            <a class={`module-card accent-${item.accent}`} href={item.href}>
              <div class="module-top"><span>{item.number}</span><small>{item.status}</small></div>
              <p class="module-label">{item.label}</p><h3>{item.title}</h3><p class="module-description">{item.description}</p>
              <div class="module-diagram" aria-hidden="true">
                {item.diagram.map((part, index) => <><span>{part}</span>{index < item.diagram.length - 1 && <i>→</i>}</>)}
              </div>
              <div class="module-link">{item.cta} <span aria-hidden="true">↗</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-about portfolio-shell">
      <p class="section-index">{t.aboutIndex}</p>
      <div><h2>{t.aboutA}<br /><em>{t.aboutB}</em></h2><p>{t.aboutCopy}</p></div>
      <a href={aboutPath}>{t.aboutCta} <span aria-hidden="true">→</span></a>
    </section>

    <section class="contact-section editorial-contact" id="contact">
      <div class="contact-rings" aria-hidden="true"></div>
      <div class="contact-content">
        <p class="portfolio-kicker"><span></span> {t.contactKicker}</p>
        <h2>{t.contactA}<br /><em>{t.contactB}</em></h2>
        <p>{t.contactCopy}</p>
        <div class="contact-links">
          <a href={socialLinks.email}>{t.email} <span aria-hidden="true">↗</span></a>
          <a href={socialLinks.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span><span class="visually-hidden">{newTab}</span></a>
          <a href={aboutPath}>{t.about} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="portfolio-footer">
    <a class="portfolio-brand" href="#inicio"><span class="brand-monogram">MF</span><span>Matías Fernández</span></a>
    <p>Notes · Side projects · Systems</p><span>{t.footer}</span>
  </footer>

  <script>
    const header = document.querySelector('[data-portfolio-header]');
    const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 20);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  </script>
</Layout>
