---
import Layout from '../layouts/Layout.astro';
import PixelWordmark from './PixelWordmark.astro';
import PortfolioHeader from './PortfolioHeader.astro';
import '../styles/portfolio.css';
import {
  condensedExperience,
  contactLinks,
  positioning,
  preferredEnvironment,
  routes,
  targetRoles,
} from '../content/profile';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
const route = routes[lang];
const alternatePath = en ? routes.es.about : routes.en.about;
const newTab = en ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)';

const leadership = en ? [
  { number: '01', title: 'Stay hands-on', copy: 'I stay close to architecture and implementation, especially where frontend decisions meet APIs, data, AI behavior, and delivery constraints.', tone: 'coral' },
  { number: '02', title: 'Make decisions legible', copy: 'I write down conventions, constraints, and trade-offs so the team can challenge a decision and maintain it after the original context fades.', tone: 'blue' },
  { number: '03', title: 'Raise the team', copy: 'Code reviews, mentoring, pairing, and useful documentation are part of delivery—not work postponed until after the product ships.', tone: 'lime' },
] : [
  { number: '01', title: 'Mantenerme hands-on', copy: 'Me mantengo cerca de la arquitectura y la implementación, sobre todo donde las decisiones frontend se cruzan con APIs, datos, comportamiento de AI y restricciones de entrega.', tone: 'coral' },
  { number: '02', title: 'Hacer legibles las decisiones', copy: 'Documento convenciones, restricciones y trade-offs para que el equipo pueda discutir una decisión y mantenerla cuando el contexto original ya no está.', tone: 'blue' },
  { number: '03', title: 'Elevar al equipo', copy: 'Code reviews, mentoring, pairing y documentación útil son parte de la entrega, no trabajo que queda para después de publicar el producto.', tone: 'lime' },
];

const workingStyle = en ? [
  ['PRODUCT', 'Start from the user state and the operational reality, then choose the architecture.'],
  ['DELIVERY', 'Prefer small, observable slices with explicit failure and recovery paths.'],
  ['QUALITY', 'Use types, tests, accessibility, and review as design tools—not only as gates.'],
  ['COMMUNICATION', 'Surface uncertainty early and separate measured results, implemented capabilities, and targets.'],
] : [
  ['PRODUCTO', 'Partir del estado del usuario y la realidad operativa, y desde ahí elegir la arquitectura.'],
  ['ENTREGA', 'Preferir slices pequeños y observables, con caminos explícitos de falla y recuperación.'],
  ['CALIDAD', 'Usar tipos, tests, accesibilidad y reviews como herramientas de diseño, no solo como gates.'],
  ['COMUNICACIÓN', 'Exponer temprano la incertidumbre y separar resultados medidos, capacidades implementadas y objetivos.'],
];

const t = en ? {
  title: 'About — Matías Fernández',
  description: 'How Matías Fernández works as a Senior Full-Stack Engineer across TypeScript, React, Next.js, Node.js, AWS, and AI-enabled products.',
  kicker: 'ABOUT · PROFILE & WORKING STYLE',
  heroA: 'Full-stack ownership.', heroEm: 'Product judgment.', heroB: ' Hands-on leadership.',
  intro: 'I’m a Senior Full-Stack Engineer who builds reliable products with TypeScript, React, Next.js, Node.js, AWS, and production AI systems.',
  explore: 'How I work', home: 'Professional home',
  profileIndex: '01 / PROFILE', profileA: 'Frontend depth.', profileB: 'Full-stack ownership.',
  profileP1: 'TypeScript, React, Next.js, and frontend architecture are my deepest strengths. More than ten years of product work have also taken me through Node.js APIs, data, AWS and Azure delivery, distributed workflows, and applied AI—enough range to own the complete system behind an interface.',
  profileP2: 'Today I lead the frontend of an enterprise AI product while contributing hands-on across its surrounding stack. I care about clear product states, honest evidence, maintainable boundaries, and teams that can explain why a system works the way it does.',
  leadLabel: 'HOW I LEAD',
  leadershipIndex: '02 / LEADERSHIP BEHAVIOR', leadershipA: 'Direction through', leadershipB: 'the work itself.', leadershipCopy: 'Leadership is a behavior in my current role, not an inflated formal title.',
  styleIndex: '03 / WORKING STYLE', styleA: 'Make the important things', styleB: 'explicit.', styleCopy: 'The habits I bring to ambiguous, cross-functional product work.',
  experienceIndex: '04 / SELECTED EXPERIENCE', experienceA: 'A concise path through', experienceB: 'ten years of delivery.', experienceCopy: 'The full résumé carries the complete history; these roles show the through-line and link to the evidence that can be published.', fullResume: 'Open the complete résumé', caseLabel: 'Related evidence',
  environmentIndex: '05 / PREFERRED ENVIRONMENT', environmentA: 'Autonomy, context,', environmentB: 'and useful constraints.', environmentCopy: 'I do my best work with product teams that share context, trust engineers with decisions, and care about reliable delivery.', roles: 'BEST-FIT ROLES', environment: 'PREFERRED ENVIRONMENT',
  contactKicker: 'Based in Argentina · working across American time zones', contactA: 'Let’s talk about', contactB: 'the product and the system.', contactCopy: 'I’m focused on Senior Full-Stack Engineer roles across TypeScript, React, Next.js, Node.js, AWS, and AI-enabled products.', email: 'Send an email', footer: 'Built with explicit trade-offs.',
} : {
  title: 'Sobre mí — Matías Fernández',
  description: 'Cómo trabaja Matías Fernández como Senior Full-Stack Engineer con TypeScript, React, Next.js, Node.js, AWS y productos con AI.',
  kicker: 'SOBRE MÍ · PERFIL & FORMA DE TRABAJO',
  heroA: 'Ownership full-stack.', heroEm: 'Criterio de producto.', heroB: ' Liderazgo hands-on.',
  intro: 'Soy Senior Full-Stack Engineer y construyo productos confiables con TypeScript, React, Next.js, Node.js, AWS y sistemas de AI en producción.',
  explore: 'Cómo trabajo', home: 'Inicio profesional',
  profileIndex: '01 / PERFIL', profileA: 'Profundidad frontend.', profileB: 'Ownership full-stack.',
  profileP1: 'TypeScript, React, Next.js y la arquitectura frontend son mis fortalezas más profundas. Más de diez años de trabajo en producto también me llevaron por APIs Node.js, datos, entrega sobre AWS y Azure, flujos distribuidos y AI aplicada: el alcance necesario para ser responsable del sistema completo detrás de una interfaz.',
  profileP2: 'Hoy lidero el frontend de un producto empresarial de AI y contribuyo hands-on en el stack que lo rodea. Me importan los estados de producto claros, la evidencia honesta, los límites mantenibles y los equipos que pueden explicar por qué un sistema funciona como funciona.',
  leadLabel: 'CÓMO LIDERO',
  leadershipIndex: '02 / COMPORTAMIENTO DE LIDERAZGO', leadershipA: 'Dirección desde', leadershipB: 'el trabajo mismo.', leadershipCopy: 'El liderazgo es un comportamiento en mi rol actual, no un título formal inflado.',
  styleIndex: '03 / FORMA DE TRABAJO', styleA: 'Hacer explícito', styleB: 'lo importante.', styleCopy: 'Los hábitos que llevo al trabajo de producto ambiguo y cross-functional.',
  experienceIndex: '04 / EXPERIENCIA SELECCIONADA', experienceA: 'Un recorrido conciso por', experienceB: 'diez años de entrega.', experienceCopy: 'El CV contiene el historial completo; estos roles muestran el hilo conductor y enlazan la evidencia que se puede publicar.', fullResume: 'Abrir el CV completo', caseLabel: 'Evidencia relacionada',
  environmentIndex: '05 / ENTORNO PREFERIDO', environmentA: 'Autonomía, contexto', environmentB: 'y restricciones útiles.', environmentCopy: 'Hago mi mejor trabajo con equipos de producto que comparten contexto, confían decisiones a ingeniería y cuidan la entrega confiable.', roles: 'ROLES QUE MEJOR ENCAJAN', environment: 'ENTORNO PREFERIDO',
  contactKicker: 'Desde Argentina · trabajando en husos horarios americanos', contactA: 'Hablemos del producto', contactB: 'y del sistema.', contactCopy: 'Mi foco está en roles de Senior Full-Stack Engineer con TypeScript, React, Next.js, Node.js, AWS y productos con AI.', email: 'Enviar un email', footer: 'Construido con trade-offs explícitos.',
};
---

<Layout title={t.title} description={t.description} lang={lang} alternateHref={alternatePath} mainId="inicio">
  <PortfolioHeader {lang} current="about" alternateHref={alternatePath} />

  <main id="inicio" tabindex="-1" class="portfolio-main about-page-v2">
    <section class="portfolio-hero portfolio-shell about-hero-v2">
      <div class="hero-intro">
        <p class="portfolio-kicker"><span></span> {t.kicker}</p>
        <h1>{t.heroA}<br /><em>{t.heroEm}</em><br />{t.heroB}</h1>
        <p class="hero-summary">{t.intro}</p>
        <div class="portfolio-actions"><a class="primary-action" href="#profile">{t.explore} <span aria-hidden="true">↓</span></a><a class="quiet-action" href={route.home}>{t.home} <span aria-hidden="true">→</span></a></div>
      </div>
      <aside class="hero-index about-positioning" aria-label={en ? 'Professional positioning' : 'Posicionamiento profesional'}>
        <header><span>{positioning.role[lang]}</span><p>{positioning.specialization[lang]}</p></header>
        <p>{positioning.statement[lang]}</p><strong>{positioning.availability[lang]}</strong>
      </aside>
    </section>

    <section class="about-section portfolio-shell" id="profile" aria-labelledby="profile-title">
      <p class="section-index">{t.profileIndex}</p>
      <div class="about-copy"><h2 id="profile-title">{t.profileA}<br /><em>{t.profileB}</em></h2><div class="about-details"><p>{t.profileP1}</p><p>{t.profileP2}</p></div></div>
      <aside class="working-on"><span>{t.leadLabel}</span><ul>{leadership.map((item) => <li><b>{item.number}</b> {item.title}</li>)}</ul></aside>
    </section>

    <section class="expertise-section" aria-labelledby="leadership-title"><div class="portfolio-shell">
      <div class="section-heading expertise-heading"><div><p class="section-index">{t.leadershipIndex}</p><h2 id="leadership-title">{t.leadershipA}<br /><em>{t.leadershipB}</em></h2></div><p>{t.leadershipCopy}</p></div>
      <div class="capability-grid">{leadership.map((item) => <article class={`capability-card capability-${item.tone}`}><div><span>{item.number}</span><small>{t.leadLabel}</small></div><h3>{item.title}</h3><p>{item.copy}</p></article>)}</div>
    </div></section>

    <section class="stack-section portfolio-shell" aria-labelledby="style-title">
      <div class="section-heading expertise-heading"><div><p class="section-index">{t.styleIndex}</p><h2 id="style-title">{t.styleA}<br /><em>{t.styleB}</em></h2></div><p>{t.styleCopy}</p></div>
      <div class="stack-groups about-style-grid">{workingStyle.map(([label, copy], index) => <article><div><span>0{index + 1}</span><h3>{label}</h3></div><p>{copy}</p></article>)}</div>
    </section>

    <section class="experience-section portfolio-shell" id="experience" aria-labelledby="experience-title">
      <div class="experience-heading"><div><p class="section-index">{t.experienceIndex}</p><h2 id="experience-title">{t.experienceA}<br /><em>{t.experienceB}</em></h2></div><div><p>{t.experienceCopy}</p><a href={route.resume}>{t.fullResume} <span aria-hidden="true">↗</span></a></div></div>
      <div class="experience-list">{condensedExperience.map((item, index) => <article class={`experience-item experience-${item.tone}`}><div class="experience-rail"><span>{String(index + 1).padStart(2, '0')}</span><i></i></div><div class="experience-period">{item.period[lang]}</div><div class="experience-role"><small>{item.context[lang]}</small><h3>{item.company[lang]}</h3><p>{item.role[lang]}</p></div><div class="experience-detail"><p>{item.summary[lang]}</p><strong>{item.proof[lang]}</strong>{item.caseStudies && <div class="experience-cases"><small>{t.caseLabel}</small>{item.caseStudies.map((study) => <a href={study.href[lang]}>{study.label[lang]} <span aria-hidden="true">→</span></a>)}</div>}</div></article>)}</div>
    </section>

    <section class="about-environment portfolio-shell" aria-labelledby="environment-title">
      <div><p class="section-index">{t.environmentIndex}</p><h2 id="environment-title">{t.environmentA}<br /><em>{t.environmentB}</em></h2><p>{t.environmentCopy}</p></div>
      <dl><div><dt>{t.roles}</dt><dd>{targetRoles[lang]}</dd></div><div><dt>{t.environment}</dt><dd>{preferredEnvironment[lang]}</dd></div></dl>
    </section>

    <section class="contact-section" aria-labelledby="contact-title"><div class="contact-rings" aria-hidden="true"></div><div class="contact-content"><p class="portfolio-kicker"><span></span> {t.contactKicker}</p><h2 id="contact-title">{t.contactA}<br /><em>{t.contactB}</em></h2><p>{t.contactCopy}</p><div class="contact-links"><a href={contactLinks.email}>{t.email} <span aria-hidden="true">↗</span></a><a href={contactLinks.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden">{newTab}</span></a><a href={contactLinks.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span><span class="visually-hidden">{newTab}</span></a><a href={route.resume}>{en ? 'Résumé' : 'CV'} <span aria-hidden="true">↗</span></a></div></div></section>
  </main>

  <footer class="portfolio-footer"><a class="portfolio-brand" href={route.home}><PixelWordmark compact /></a><p>Product · Applied AI · Systems</p><span>{t.footer}</span></footer>
</Layout>
