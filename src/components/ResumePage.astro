---
import Layout from '../layouts/Layout.astro';
import {
  resumeVariantMeta,
  resumeVariants,
  type ResumeVariantId,
} from '../content/resume';
import { routes } from '../content/profile';
import '../styles/resume.css';

interface Props { lang: 'es' | 'en'; variant?: ResumeVariantId; }
const { lang, variant = 'frontend-lead' } = Astro.props;
const en = lang === 'en';
const newTab = en ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)';
const homePath = routes[lang].home;
const alternatePath = resumeVariantMeta[variant].path[en ? 'es' : 'en'];

/* All résumé content lives in src/content/resume.ts, which also feeds the
   LaTeX output. Do not add résumé copy here. */
const cv = resumeVariants[lang][variant];
const variantOptions = (Object.keys(resumeVariantMeta) as ResumeVariantId[])
  .map((id) => ({ id, ...resumeVariantMeta[id] }));

/* The screen layout splits the name across two lines. Print CSS hides the <br>. */
const [firstName, ...lastName] = cv.name.split(' ');

/* LaTeX PDF generated by `npm run cv:pdf` and committed under public/. */
const pdfPath = resumeVariantMeta[variant].pdfPath[lang];
const variantLabel = resumeVariantMeta[variant].label[lang];
---

<Layout
  title={en ? `${variantLabel} résumé — Matías Fernández` : `CV ${variantLabel} — Matías Fernández`}
  description={en ? `${variantLabel} résumé for Matías Fernández, Senior Full-Stack Engineer working with TypeScript, React, Next.js, Node.js, AWS, and AI products.` : `CV ${variantLabel} de Matías Fernández, Senior Full-Stack Engineer con TypeScript, React, Next.js, Node.js, AWS y productos de AI.`}
  lang={lang}
  alternateHref={alternatePath}
>
  <main id="main-content" tabindex="-1" class="resume-page">
    <header class="resume-toolbar">
      <a href={homePath}>← {en ? 'Portfolio' : 'Portfolio'}</a>
      <div class="resume-toolbar-actions">
        <nav class="resume-variants" aria-label={en ? 'Choose résumé focus' : 'Elegir foco del CV'}>
          {variantOptions.map((option) => (
            <a href={option.path[lang]} aria-current={option.id === variant ? 'page' : undefined}>{option.label[lang]}</a>
          ))}
        </nav>
        <nav class="resume-language" aria-label={en ? 'Choose language' : 'Elegir idioma'}><a href={resumeVariantMeta[variant].path.es} lang="es" hreflang="es" aria-current={!en ? 'page' : undefined}>ES</a><a href={resumeVariantMeta[variant].path.en} lang="en" hreflang="en" aria-current={en ? 'page' : undefined}>EN</a></nav>
        <a class="resume-download" href={pdfPath} download>{en ? 'Download PDF' : 'Descargar PDF'} <span aria-hidden="true">↓</span></a>
        <button type="button" onclick="window.print()">{en ? 'Print' : 'Imprimir'} <span aria-hidden="true">↗</span></button>
      </div>
    </header>

    <article class="resume-sheet">
      <header class="resume-identity">
        <div><h1>{firstName} <br />{lastName.join(' ')}</h1><p>{cv.headline}</p></div>
        <div class="resume-contact"><span>{cv.location}</span>{cv.contacts.map((item) => <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>{item.label}<span class="resume-ext" aria-hidden="true"> ↗</span>{item.href.startsWith('http') && <span class="visually-hidden">{newTab}</span>}</a>)}</div>
      </header>

      <section class="resume-summary">
        <p class="resume-section-label"><span class="resume-label-index">01 / </span>{cv.labels.profile}</p>
        <div>
          <h2>{cv.summary.headline}</h2>
          <p>{cv.summary.body}</p>
        </div>
      </section>

      <section class="resume-experience">
        <p class="resume-section-label"><span class="resume-label-index">02 / </span>{cv.labels.experience}</p>
        <div>{cv.roles.map((item) => <article><div class="resume-role-heading"><div><small>{item.context}</small><h3>{item.company}</h3><p>{item.role}</p></div><span>{item.period}</span></div><ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul></article>)}</div>
      </section>

      <section class="resume-skills">
        <p class="resume-section-label"><span class="resume-label-index">03 / </span>{cv.labels.stack}</p>
        <div>{cv.skills.map((group) => <article><h3>{group[0]}</h3><p>{group[1]}</p></article>)}</div>
      </section>

      <section class="resume-bottom">
        <div><p class="resume-section-label"><span class="resume-label-index">04 / </span>{cv.labels.education}</p><h3>{cv.education.degree}</h3><p>{cv.education.detail}</p></div>
        <div><p class="resume-section-label"><span class="resume-label-index">05 / </span>{cv.labels.languages}</p><h3>{cv.languages.primary}</h3><p>{cv.languages.secondary}</p></div>
      </section>
    </article>
  </main>
</Layout>
