---
import Layout from '../layouts/Layout.astro';
import '../styles/portfolio.css';
import '../styles/work.css';
import { navigation, routes, type Lang } from '../content/profile';
import type { WorkCaseStudy } from '../content/work';

interface Props { lang: Lang; study: WorkCaseStudy; }
const { lang, study } = Astro.props;
const en = lang === 'en';
const route = routes[lang];
const alternate = study.routes[en ? 'es' : 'en'];
const nav = navigation(lang);
const newTab = en ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)';
const stateLabel = (state: 'accepted' | 'implemented' | 'planned') => en
  ? ({ accepted: 'Accepted', implemented: 'Implemented · acceptance pending', planned: 'Planned' }[state])
  : ({ accepted: 'Aceptado', implemented: 'Implementado · aceptación pendiente', planned: 'Planeado' }[state]);
const kindLabel = (kind: 'measured' | 'implemented' | 'target') => en
  ? ({ measured: 'Measured result', implemented: 'Implemented capability', target: 'Target' }[kind])
  : ({ measured: 'Resultado medido', implemented: 'Capacidad implementada', target: 'Objetivo' }[kind]);
const attributionLabel = (attribution: 'individual' | 'team') => en
  ? ({ individual: 'individual', team: 'team result' }[attribution])
  : ({ individual: 'individual', team: 'resultado de equipo' }[attribution]);
const linkKindLabel = (kind: 'source' | 'evidence' | 'artifact') => en
  ? ({ source: 'Source', evidence: 'Evidence', artifact: 'Working artifact' }[kind])
  : ({ source: 'Código', evidence: 'Evidencia', artifact: 'Producto ejecutable' }[kind]);
const t = en ? {
  nav: 'Main navigation', language: 'Choose language', back: 'All work', status: 'Current status',
  glance: 'At a glance', role: 'Role', period: 'Period', team: 'Team', stack: 'Stack', availability: 'Source and demo',
  overview: 'Overview', problem: 'The problem', responsibility: 'My responsibility', constraints: 'Constraints',
  architecture: 'Architecture', decisions: 'Key decisions', tradeoffs: 'Trade-offs', failure: 'Failure modes',
  results: 'Results and evidence', roadmap: 'Delivery state', next: 'What I would improve next', links: 'Related links',
  context: 'Context', choice: 'Decision', consequence: 'Consequence', gained: 'What it enables', cost: 'What it costs',
  evidence: 'Open evidence', footer: 'PUBLIC ENGINEERING CASE STUDY', top: 'Back to top', contents: 'Case study sections',
} : {
  nav: 'Navegación principal', language: 'Elegir idioma', back: 'Todo el trabajo', status: 'Estado actual',
  glance: 'De un vistazo', role: 'Rol', period: 'Período', team: 'Equipo', stack: 'Stack', availability: 'Código y demo',
  overview: 'Overview', problem: 'El problema', responsibility: 'Mi responsabilidad', constraints: 'Restricciones',
  architecture: 'Arquitectura', decisions: 'Decisiones clave', tradeoffs: 'Trade-offs', failure: 'Modos de falla',
  results: 'Resultados y evidencia', roadmap: 'Estado de entrega', next: 'Qué mejoraría después', links: 'Links relacionados',
  context: 'Contexto', choice: 'Decisión', consequence: 'Consecuencia', gained: 'Qué habilita', cost: 'Qué cuesta',
  evidence: 'Abrir evidencia', footer: 'CASO DE ESTUDIO DE INGENIERÍA PÚBLICO', top: 'Volver arriba', contents: 'Secciones del caso de estudio',
};
const toc = [
  ['overview', t.overview], ['problem', t.problem], ['responsibility', t.responsibility],
  ['architecture', t.architecture], ['decisions', t.decisions], ['results', t.results], ['next', t.next],
];
---

<Layout title={study.seoTitle[lang]} description={study.description[lang]} lang={lang} alternateHref={alternate} mainId="case-main">
  <header class="portfolio-header work-header" data-portfolio-header>
    <a class="portfolio-brand" href={route.home} aria-label={en ? 'Matías Fernández, home' : 'Matías Fernández, inicio'}><span class="brand-monogram" aria-hidden="true">MF</span><span>Matías Fernández</span></a>
    <nav aria-label={t.nav}>{nav.map((item) => <a href={item.href} aria-current={item.href === route.work ? 'page' : undefined}>{item.label}</a>)}</nav>
    <nav class="language-switcher" aria-label={t.language}>
      <a href={study.routes.es} lang="es" hreflang="es" aria-current={!en ? 'page' : undefined}>ES</a>
      <a href={study.routes.en} lang="en" hreflang="en" aria-current={en ? 'page' : undefined}>EN</a>
    </nav>
  </header>

  <main id="case-main" tabindex="-1" class="case-study">
    <section class="portfolio-shell case-hero">
      <div>
        <a class="case-back" href={route.work}>← {t.back}</a>
        <p class="portfolio-kicker"><span></span>{study.eyebrow[lang]}</p>
        <h1>{study.title[lang]}</h1>
        <p class="case-lede">{study.description[lang]}</p>
      </div>
      <aside class="case-status" aria-label={t.status}>
        <p>{t.status}</p><strong>{study.status.progress[lang]}</strong><span>{study.status.headline[lang]}</span>
        <small><time datetime={study.status.updatedAt}>{study.status.updatedAt}</time></small>
      </aside>
    </section>

    <section class="case-glance" aria-labelledby="glance-title">
      <div class="portfolio-shell"><h2 id="glance-title">{t.glance}</h2><dl>
        <div><dt>{t.role}</dt><dd>{study.role[lang]}</dd></div>
        <div><dt>{t.period}</dt><dd>{study.period[lang]}</dd></div>
        <div><dt>{t.team}</dt><dd>{study.team[lang]}</dd></div>
        <div><dt>{t.stack}</dt><dd>{study.stack.join(' · ')}</dd></div>
        <div><dt>{t.availability}</dt><dd>{study.availability[lang]}</dd></div>
      </dl></div>
    </section>

    <div class="portfolio-shell case-reading-layout">
      <nav class="case-toc" aria-label={t.contents}><ol>{toc.map(([href, label], index) => <li><a href={`#${href}`}><span>{String(index + 1).padStart(2, '0')}</span>{label}</a></li>)}</ol></nav>
      <div class="case-body">
        <section id="overview" class="case-section case-intro"><p class="section-index">01 / {t.overview}</p><h2>{study.overview[lang]}</h2></section>

        <section id="problem" class="case-section"><p class="section-index">02 / {t.problem}</p><h2>{t.problem}</h2><p class="case-large-copy">{study.problem[lang]}</p></section>

        <section id="responsibility" class="case-section case-split"><div><p class="section-index">03 / {t.responsibility}</p><h2>{t.responsibility}</h2><ul>{study.responsibility.map((item) => <li>{item[lang]}</li>)}</ul></div><div><p class="section-index">{t.constraints}</p><h3>{t.constraints}</h3><ul>{study.constraints.map((item) => <li>{item[lang]}</li>)}</ul></div></section>

        <section id="architecture" class="case-section"><p class="section-index">04 / {t.architecture}</p><h2>{t.architecture}</h2><figure class="case-architecture"><figcaption><strong>{study.architecture.label[lang]}</strong><p>{study.architecture.description[lang]}</p></figcaption><ol>{study.architecture.stages.map((stage, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{stage.label[lang]}</strong><small>{stage.detail[lang]}</small></li>)}</ol></figure></section>

        <section id="decisions" class="case-section"><p class="section-index">05 / {t.decisions}</p><h2>{t.decisions}</h2><div class="case-decisions">{study.decisions.map((decision, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{decision.title[lang]}</h3><dl><div><dt>{t.context}</dt><dd>{decision.context[lang]}</dd></div><div><dt>{t.choice}</dt><dd>{decision.choice[lang]}</dd></div><div><dt>{t.consequence}</dt><dd>{decision.consequence[lang]}</dd></div></dl></article>)}</div></section>

        <section class="case-section"><p class="section-index">06 / {t.tradeoffs}</p><h2>{t.tradeoffs}</h2><div class="case-tradeoffs">{study.tradeoffs.map((tradeoff) => <article><h3>{tradeoff.choice[lang]}</h3><p><strong>{t.gained}</strong>{tradeoff.gained[lang]}</p><p><strong>{t.cost}</strong>{tradeoff.cost[lang]}</p></article>)}</div></section>

        <section class="case-section case-failures"><p class="section-index">07 / {t.failure}</p><h2>{t.failure}</h2><ol>{study.failureModes.map((mode) => <li>{mode[lang]}</li>)}</ol></section>

        <section id="results" class="case-section"><p class="section-index">08 / {t.results}</p><h2>{t.results}</h2><div class="case-metrics">{study.metrics.map((metric) => <article><strong>{metric.value}</strong><p>{metric.label[lang]}</p><small>{kindLabel(metric.kind)} · {attributionLabel(metric.attribution)}</small><a href={metric.evidenceHref} target="_blank" rel="noreferrer">{t.evidence} ↗<span class="visually-hidden">{newTab}</span></a></article>)}</div></section>

        <section class="case-section"><p class="section-index">09 / {t.roadmap}</p><h2>{t.roadmap}</h2><ol class="case-milestones">{study.milestones.map((milestone) => <li class={`is-${milestone.state}`}><span>{milestone.number}</span><div><small>{stateLabel(milestone.state)} · {milestone.deliverable[lang]}</small><h3>{milestone.title[lang]}</h3><p>{milestone.description[lang]}</p></div></li>)}</ol></section>

        <section id="next" class="case-section case-next"><p class="section-index">10 / {t.next}</p><h2>{t.next}</h2><ol>{study.next.map((item) => <li>{item[lang]}</li>)}</ol></section>

        <section class="case-section case-links"><p class="section-index">11 / {t.links}</p><h2>{t.links}</h2><div>{study.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer"><small>{linkKindLabel(link.kind).toUpperCase()}</small><strong>{link.label[lang]} ↗</strong><span>{link.description[lang]}</span><span class="visually-hidden">{newTab}</span></a>)}</div></section>
      </div>
    </div>
  </main>

  <footer class="portfolio-footer work-footer"><a class="portfolio-brand" href={route.home}><span class="brand-monogram">MF</span><span>Matías Fernández</span></a><p>{t.footer}</p><a href="#case-main">{t.top} ↑</a></footer>
  <script>
    const header = document.querySelector('[data-portfolio-header]');
    const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 20);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  </script>
</Layout>
