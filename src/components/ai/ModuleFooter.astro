---
interface Props { label?: string; lang?: 'es' | 'en'; }
const { label = 'MODULE 01 · AI & HARNESSES', lang = 'en' } = Astro.props;
const homeHref = lang === 'es' ? '/es/' : '/en/';
---

<footer>
  <a class="brand footer-brand" href={homeHref} aria-label={lang === 'es' ? 'Volver al portfolio' : 'Back to the portfolio'}>
    <span class="brand-monogram" aria-hidden="true">MF</span>
    <span>Matías Fernández</span>
  </a>
  <p>{label}</p>
  <a href="#top">BACK TO TOP ↑</a>
</footer>
