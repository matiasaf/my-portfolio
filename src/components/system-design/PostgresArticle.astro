  kicker: 'STORAGE · MVCC · VACUUM',
  heroA: 'Postgres never', heroEm: 'overwrites a row.',
  lede: 'A table is a file, that file is an array of 8 KB pages, and the row a SELECT returns is really one version stored inside one of those pages. Following that chain explains the ctid, what an index actually holds, why two connections can see different prices, and why a transaction left open for hours degrades the whole database.',
  meta: [['PUBLISHED', 'AUG 26 2026'], ['READING', '~16 min'], ['LANGUAGE', 'EN · ES'], ['ORIGIN', 'Hussein Nasser video']],
  chainCaption: ['FROM TABLE TO VERSION', 'FOUR LEVELS'],
  chain: [
    ['FILE', 'A table is one or more files on disk, split into 1 GB segments.'],
    ['PAGE', 'The file is an array of 8 KB blocks: fixed size, computable offset.'],
    ['LINE POINTER', 'Inside the page, a pointer says where each tuple begins.'],
    ['TUPLE', 'The physical data: one version of the row, carrying xmin and xmax.'],
  ],
  chainFoot: ['TABLE', 'VERSION'],
  thesisLabel: 'THE CENTRAL IDEA',
  thesis: 'An UPDATE does not modify a row: it writes a new version and leaves the previous one waiting until no transaction could possibly need it.',

  s1Number: '01 / FROM FILE TO PAGE', s1Title: ['A table is a file', 'of fixed-size blocks.'],
  s1Intro: 'Postgres does not read individual rows from disk: it reads whole pages. That bureaucratic-sounding detail defines the cost of almost everything else.',
  boardLabel: 'SEE IT IN YOUR DATABASE', boardTitle: 'All of this is queryable from psql.',
  boardCopy: 'The file, the block size, the ctid, and the system columns are not hidden internals: any instance will show them to you.',
  boardLabels: ['FILE', 'BLOCK', 'VERSIONS', 'HEALTH'],
  boardCalloutLabel: 'WHY IT MATTERS',
  boardCallout: 'Reading a 100-byte row costs, at minimum, pulling its 8 KB page into memory. That is why tuple size and data locality matter so much for performance.',
  canvasTitle: 'Six pieces of the storage model',
  canvas: [
    ['01', 'File and segments', 'Every table and index has its own file, split into 1 GB segments inside the cluster directory.'],
    ['02', '8 KB page', 'The block is fixed: 8192 bytes by default, set at compile time. The engine reasons in pages, not rows.'],
    ['03', 'Computable offset', 'Page N begins at N × 8192. Nothing is searched: the engine jumps straight there and loads the block.'],
    ['04', 'Shared buffers', 'Pages are read and modified in shared memory; the disk receives the WAL first and the pages later.'],
    ['05', 'TOAST', 'A value too large for a page is compressed and stored out of line, in an associated table.'],
    ['06', 'WAL', 'Durability does not depend on writing the page: it depends on the change record reaching the log first.'],
  ],

  s2Number: '02 / INSIDE ONE PAGE', s2Title: ['The page carries', 'its own directory.'],
  s2Intro: 'A page is not a flat block of rows. It has a header, an array of pointers that grows forward, and tuples written from the end backwards. Free space is what remains in between.',
  anatomyCaption: ['PAGE 0 · 8192 BYTES', 'HEADER · POINTERS · TUPLES'],
  anatomyLabels: ['PAGE HEADER', 'LINE POINTERS', 'FREE SPACE', 'TUPLES'],
  anatomyHeader: '24 bytes: checksum, LSN, and where free space starts and ends.',
  anatomyFree: 'pointers grow forward · tuples are written from the end',
  anatomyTuples: [
    ['TUPLE · ctid (0,2)', 'price 20.00 · xmin 964 · xmax 0'],
    ['TUPLE · ctid (0,1)', 'price 10.00 · xmin 712 · xmax 964'],
  ],
  anatomyFootLabel: 'CTID',
  anatomyFoot: 'The ctid is the pair (page number, pointer index). (0,1) means page 0, first pointer. With that, finding a tuple is arithmetic rather than search.',
  pageCards: [
    ['01', 'The pointer is the indirection', 'Moving a tuple within its page touches nothing else: updating the line pointer is enough.'],
    ['02', 'A ctid locates a version', 'It changes on every UPDATE and can change during VACUUM FULL or CLUSTER. Use it to inspect, never to identify.'],
    ['03', 'Free space is managed', 'fillfactor reserves room on each page for future versions, and the free space map remembers where room is left.'],
  ],
  authorityLabel: 'RULE', authority: 'A ctid locates a version. The primary key identifies a row.',

  s3Number: '03 / THE HEAP AND ITS INDEXES', s3Title: ['An index does not store rows.', 'It stores addresses.'],
  s3Intro: 'The heap is the set of pages where tuples live. A B-tree index is a separate structure with its own pages, and its leaves hold a key plus the ctid it points to.',
  lookupCaption: ['INDEX items_pkey · HEAP items', 'LOOKUP FOR item_id = 100'],
  lookupPanels: [
    ['B-TREE', 'Ordered descent', 'From the root to the leaf, comparing keys at each level.'],
    ['ENTRY', 'Key → ctid', 'The leaf does not hold the price: it holds the address of one version.'],
    ['HEAP', 'Page fetch', 'Postgres loads page 0, follows pointer 2, and only then reads the tuple.'],
  ],
  lookupFootLabel: 'WHY THE HEAP FETCH HAPPENS',
  lookupFoot: 'Visibility is not in the index: it lives in the tuple. That is why an index scan almost always ends up reading the heap, and why the visibility map exists — it enables index-only scans once a whole page is visible to everyone.',
  note3Label: 'AN INDEX IS NOT A COPY OF THE TABLE',
  note3: 'Every extra index is another file to maintain on every write and another path the planner may choose or discard. An unused index is not neutral: it is work on every INSERT and on most UPDATEs.',

  s4Number: '04 / UPDATE DOES NOT OVERWRITE', s4Title: ['Every change writes', 'a new version.'],
  s4Intro: 'Postgres implements MVCC by keeping versions inside the same table. An UPDATE looks for free space, writes the new tuple, and marks the previous one as obsolete from a given transaction onward.',
  versionsCaption: ['UPDATE items SET price = 20 WHERE item_id = 100', 'TRANSACTION 964'],
  versionsHead: ['CTID', 'XMIN', 'XMAX', 'PRICE', 'STATE'],
  versionStates: ['previous version · dead candidate', 'current version'],
  versionsFootLabel: 'TWO HIDDEN FIELDS',
  versionsFoot: 'xmin is the transaction that created the tuple; xmax is the one that deleted it or made it obsolete by updating it, and stays at 0 while the version is current. They are system columns: readable, never writable.',
  opCards: [
    ['01', 'INSERT', 'Writes a tuple with xmin set to your transaction and xmax at 0.', 'If the chosen page has no room another is used, and if none has room the file is extended.'],
    ['02', 'UPDATE', 'Writes a new tuple and sets xmax on the previous one.', 'The old version keeps occupying space until vacuum recycles it.'],
    ['03', 'DELETE', 'Erases nothing: it only writes xmax on the current version.', 'Space is released later, once no transaction can still see that tuple.'],
  ],
  s4CalloutLabel: 'THE CONSEQUENCE',
  s4Callout: 'A heavily updated table grows even when the row count stays constant. Size on disk does not measure how much data you have: it measures how many versions have not been recycled yet.',

  s5Number: '05 / VISIBILITY', s5Title: ['Two connections,', 'two valid truths.'],
  s5Intro: 'When a query reaches the heap it may find several versions of the same row. Choosing which one to return is not a global decision: it depends on that transaction’s snapshot and on the commit status behind xmin and xmax.',
  snapshotCaption: ['SAME ROW · SAME INSTANT', 'ONE SNAPSHOT PER TRANSACTION'],
  lanes: [
    ['T1 · OPENED EARLIER', 'BEGIN before the commit', 'Its snapshot does not include transaction 964, so it keeps seeing the previous version.'],
    ['T2 · OPENED LATER', 'BEGIN after the commit', 'It sees the version created by 964 and discards the previous one because of its xmax.'],
  ],
  snapshotFootLabel: 'ISOLATION LEVEL',
