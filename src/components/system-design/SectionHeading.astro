---
interface Props { number: string; title: string; emphasis: string; description: string; light?: boolean; }
const { number, title, emphasis, description, light = false } = Astro.props;
---
<div class:list={['sd-section-heading', { light }]}>
  <p class="section-number">{number}</p>
  <div><h2>{title}<br /><em>{emphasis}</em></h2><p>{description}</p></div>
</div>
