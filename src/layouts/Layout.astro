---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonicalHref?: string;
  alternateHref?: string;
  ogType?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  /** Page <main> id used as the skip-link destination. */
  mainId?: string;
}

const {
  title,
  description,
  lang = 'en',
  canonicalHref,
  alternateHref,
  ogType = 'website',
  image,
  publishedTime,
  mainId = 'main-content',
} = Astro.props;
const skipLabel = lang === 'es' ? 'Saltar al contenido' : 'Skip to content';
const canonicalUrl = new URL(canonicalHref ?? Astro.url.pathname, Astro.url.origin);
const alternateUrl = alternateHref ? new URL(alternateHref, Astro.url.origin) : undefined;
const imageUrl = image ? new URL(image, Astro.url.origin) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdfcfc" data-theme-color />
    <script is:inline>
      (() => {
        const storageKey = 'mf-color-theme';
        let storedTheme = null;
        try { storedTheme = localStorage.getItem(storageKey); } catch {}
        const theme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Pixelify+Sans:wght@500;700&display=swap"
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Matías Fernández" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrl && <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={alternateUrl} />}
    {alternateUrl && <link rel="alternate" hreflang={lang} href={canonicalUrl} />}
    {alternateUrl && <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonicalUrl : alternateUrl} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href={`#${mainId}`}>{skipLabel}</a>
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label={lang === 'es' ? 'Cambiar tema de color' : 'Change color theme'}
      title={lang === 'es' ? 'Cambiar tema de color' : 'Change color theme'}
    >
      <span class="theme-toggle-icon" data-theme-icon aria-hidden="true">◐</span>
      <span class="theme-toggle-label" data-theme-label>{lang === 'es' ? 'Tema' : 'Theme'}</span>
    </button>
    <slot />
    <script is:inline define:vars={{ lang }}>
      (() => {
        const storageKey = 'mf-color-theme';
        const button = document.querySelector('[data-theme-toggle]');
        const icon = button?.querySelector('[data-theme-icon]');
        const label = button?.querySelector('[data-theme-label]');
        const themeColor = document.querySelector('[data-theme-color]');
        const isSpanish = lang === 'es';

        const renderTheme = (theme) => {
          const isDark = theme === 'dark';
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          if (icon) icon.textContent = isDark ? '☾' : '☀';
          if (label) label.textContent = isSpanish
            ? (isDark ? 'Oscuro' : 'Claro')
            : (isDark ? 'Dark' : 'Light');
          if (button) button.setAttribute(
            'aria-label',
            isSpanish
              ? `Cambiar a tema ${isDark ? 'claro' : 'oscuro'}`
              : `Switch to ${isDark ? 'light' : 'dark'} theme`,
          );
          button?.setAttribute('aria-pressed', String(isDark));
          themeColor?.setAttribute('content', isDark ? '#131010' : '#fdfcfc');
        };

        renderTheme(document.documentElement.dataset.theme || 'light');
        button?.addEventListener('click', () => {
          const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem(storageKey, nextTheme); } catch {}
          renderTheme(nextTheme);
        });
      })();
    </script>
  </body>
</html>
