---
import Layout from '../layouts/Layout.astro';

const translations = [
  {
    role: 'Backend',
    accent: 'coral',
    youKnow: 'APIs, jobs, queues, SQL, and services',
    fabric: 'Pipelines, notebooks, Lakehouse, and SQL endpoint',
    shift: 'The product does not answer a request: it prepares trusted data for many consumers.',
  },
  {
    role: 'Databases',
    accent: 'blue',
    youKnow: 'Tables, indexes, constraints, and stored procedures',
    fabric: 'Delta tables, semantic models, and transformations',
    shift: 'You separate storage, compute, and consumption without losing tabular logic.',
  },
  {
    role: 'Frontend',
    accent: 'lime',
    youKnow: 'State, components, product metrics, and visualization',
    fabric: 'Power BI, semantic models, and Direct Lake',
    shift: 'The final UI is a report; its contract lives in governed, reusable metrics.',
  },
  {
    role: 'Architecture',
    accent: 'violet',
    youKnow: 'Bounded contexts, integration, observability, and security',
    fabric: 'Workspaces, OneLake, lineage, capacities, and domains',
    shift: 'You design a shared data system that is operable and traceable end to end.',
  },
];

const stages = [
  { n: '01', name: 'Source', tool: 'DB · API · files', copy: 'Data is born in operational systems.' },
  { n: '02', name: 'Ingestion', tool: 'Data Factory', copy: 'A pipeline moves and schedules the flow.' },
  { n: '03', name: 'Storage', tool: 'OneLake + Lakehouse', copy: 'Files and Delta tables live in one shared place.' },
  { n: '04', name: 'Transformation', tool: 'Spark + SQL', copy: 'Data is typed, validated, joined, and prepared.' },
  { n: '05', name: 'Consumption', tool: 'Power BI', copy: 'A semantic model defines business metrics.' },
];

const layers = [
  { name: 'Bronze', tag: 'raw', copy: 'A faithful copy. Traceable. No silent corrections.', code: 'orders_2026_07.csv', tone: 'bronze' },
  { name: 'Silver', tag: 'clean', copy: 'Types, quality rules, and deduplication.', code: 'silver_orders', tone: 'silver' },
  { name: 'Gold', tag: 'business', copy: 'Business entities and metrics ready to consume.', code: 'gold_sales_by_month', tone: 'gold' },
];

const pocs = [
  {
    number: '01',
    status: 'READY TO BUILD',
    title: 'Sales Lakehouse',
    question: 'How much did we sell per month and category?',
    level: 'Starter',
    time: '60–90 min',
    path: 'CSV → Lakehouse → Spark/SQL → Power BI',
    learn: 'Medallion layers, Delta tables, quality checks, semantic metrics',
    proof: 'Four Gold rows, $2,170 total revenue, and a report that matches SQL.',
    tone: 'coral',
    available: true,
    href: '/pocs/sales-lakehouse/',
  },
  {
    number: '02',
    status: 'READY TO BUILD',
    title: 'API ingestion',
    question: 'Can we update a dataset without reloading everything?',
    level: 'Intermediate',
    time: '2–3 hours',
    path: 'REST API → Pipeline → Bronze → MERGE → Gold',
    learn: 'Pagination, incremental loads, idempotency, and watermarking',
    proof: 'Running the pipeline twice creates no duplicates and only new records change.',
    tone: 'blue',
    available: true,
    href: '/pocs/incremental-api/',
    availableCopy: 'Mock API pages, notebook, and validation SQL included',
  },
  {
    number: '03',
    status: 'READY TO BUILD',
    title: 'Customer 360',
    question: 'Which customers buy often, spend more, or are becoming inactive?',
    level: 'Intermediate',
    time: '3–4 hours',
    path: 'CRM + orders → Lakehouse → Star schema → Power BI',
    learn: 'Entity matching, dimensions, facts, measures, and data ownership',
    proof: 'Every KPI has a definition, an owner, and a query that independently verifies it.',
    tone: 'lime',
    available: true,
    href: '/pocs/customer-360/',
    availableCopy: 'Three sources, notebook, KPI catalog, DAX, and SQL included',
  },
  {
    number: '04',
    status: 'ADVANCED',
    title: 'Live operations',
    question: 'Can we detect an operational anomaly while it is happening?',
    level: 'Advanced',
    time: '4–6 hours',
    path: 'Events → Eventstream → KQL → Real-time dashboard',
    learn: 'Streaming, event time, windowing, alerts, and operational latency',
    proof: 'A simulated threshold breach appears on the dashboard and triggers an alert.',
    tone: 'violet',
  },
];
---

<Layout
  title="Fabric for software builders"
  description="A visual introduction to Microsoft Fabric for people coming from backend, frontend, databases, and software architecture."
>
  <header class="site-header" data-header>
    <a class="brand" href="/" aria-label="Back to the portfolio">
      <span class="brand-monogram" aria-hidden="true">MF</span>
      <span>Matías Fernández <em>/ Microsoft Fabric</em></span>
    </a>
    <nav aria-label="Main navigation">
      <a href="#map">The map</a>
      <a href="#translation">Your experience</a>
      <a href="#roadmap">Roadmap</a>
      <a href="#pocs">POCs</a>
    </nav>
    <a class="header-cta" href="#get-started">Get started <span aria-hidden="true">↘</span></a>
  </header>

  <main id="top">
    <section class="hero section-shell">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span> Microsoft Fabric, no fluff</p>
        <h1>You know how to build<br /><strong>software.</strong><br />Now, <em>data.</em></h1>
        <p class="hero-lede">
          An introduction to Microsoft Fabric from the world you already know:
          databases, backend, frontend, and architecture.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="#map">Understand the map <span>↓</span></a>
          <a class="text-link" href="#pocs">See practical examples <span>→</span></a>
        </div>
      </div>

      <div class="hero-visual reveal" aria-label="Comparison between a traditional application and Microsoft Fabric">
        <div class="orbit orbit-a"></div>
        <div class="orbit orbit-b"></div>
        <div class="system-card old-system">
          <p>TRADITIONAL APP</p>
          <div class="mini-stack">
            <span>UI</span><span>API</span><span>DB</span>
          </div>
          <small>One request → one response</small>
        </div>
        <div class="bridge"><span>same logic</span><b>→</b><small>different purpose</small></div>
        <div class="system-card fabric-system">
          <p>MS FABRIC</p>
          <div class="fabric-core">
            <div class="core-ring ring-one"></div>
            <div class="core-ring ring-two"></div>
            <div class="core-dot"><span>01</span><strong>OneLake</strong></div>
          </div>
          <small>One data point → many decisions</small>
        </div>
        <div class="visual-note note-one">SaaS <span>↗</span></div>
        <div class="visual-note note-two">end-to-end <span>↗</span></div>
      </div>
    </section>

    <section class="thesis-band" aria-label="Core idea">
      <p>Fabric does not replace what you know.</p>
      <p><strong>It connects it around data.</strong></p>
      <div class="marquee" aria-hidden="true">
        <span>INGESTION</span><i>✦</i><span>LAKEHOUSE</span><i>✦</i><span>TRANSFORMATION</span><i>✦</i><span>MODEL</span><i>✦</i><span>REPORT</span>
      </div>
    </section>

    <section class="map-section section-shell" id="map">
      <div class="section-intro reveal">
        <p class="section-number">01 / THE MENTAL MODEL</p>
        <h2>From an operational system<br />to an <em>analytical system.</em></h2>
        <p>You do not need to learn five isolated products. Think of them as stages in one flow.</p>
      </div>

      <div class="flow-grid reveal">
        {stages.map((stage, index) => (
          <article class="flow-card">
            <div class="flow-top"><span>{stage.n}</span>{index < stages.length - 1 && <b aria-hidden="true">→</b>}</div>
            <h3>{stage.name}</h3>
            <p class="tool-label">{stage.tool}</p>
            <p>{stage.copy}</p>
          </article>
        ))}
      </div>

      <div class="analogy reveal">
        <span class="analogy-label">IF YOU COME FROM MICROSERVICES</span>
        <p>A pipeline resembles a backend workflow, but its contracts are <strong>datasets</strong>, not request payloads.</p>
        <span class="analogy-arrow" aria-hidden="true">↗</span>
      </div>
    </section>

    <section class="translation-section" id="translation">
      <div class="section-shell">
        <div class="section-intro light reveal">
          <p class="section-number">02 / YOUR EXPERIENCE MATTERS</p>
          <h2>Translate what you know.<br /><em>Do not start from scratch.</em></h2>
        </div>

        <div class="role-tabs" role="tablist" aria-label="Choose your background">
          {translations.map((item, index) => (
            <button
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`panel-${index}`}
              id={`tab-${index}`}
              tabindex={index === 0 ? 0 : -1}
              data-tab={index}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>{item.role}
            </button>
          ))}
        </div>

        <div class="role-panels reveal">
          {translations.map((item, index) => (
            <article
              class={`role-panel accent-${item.accent}`}
              role="tabpanel"
              id={`panel-${index}`}
              aria-labelledby={`tab-${index}`}
              hidden={index !== 0}
            >
              <div>
                <p class="panel-kicker">WHAT YOU ALREADY KNOW</p>
                <h3>{item.youKnow}</h3>
              </div>
              <div class="equals" aria-hidden="true">≈</div>
              <div>
                <p class="panel-kicker">HOW IT SHOWS UP IN FABRIC</p>
                <h3>{item.fabric}</h3>
              </div>
              <p class="mindset"><span>MINDSET SHIFT</span>{item.shift}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="medallion-section section-shell">
      <div class="section-intro reveal">
        <p class="section-number">03 / A KEY PATTERN</p>
        <h2>Medallion, explained<br />as a <em>quality pipeline.</em></h2>
        <p>Each layer adds trust. They are not three products, and they do not need to be three workspaces.</p>
      </div>

      <div class="layer-stack reveal">
        {layers.map((layer, index) => (
          <article class={`layer-card ${layer.tone}`} style={`--level: ${index}`}>
            <div class="layer-index">0{index + 1}</div>
            <div>
              <span class="layer-tag">{layer.tag}</span>
              <h3>{layer.name}</h3>
            </div>
            <p>{layer.copy}</p>
            <code>{layer.code}</code>
          </article>
        ))}
      </div>
    </section>

    <section class="principles-section">
      <div class="section-shell">
        <p class="section-number reveal">04 / THREE IDEAS TO TAKE WITH YOU</p>
        <div class="principles-grid">
          <article class="reveal">
            <span>01</span>
            <h3>OneLake is the shared storage layer.</h3>
            <p>It is not “another database.” It is the logical layer where different workloads find the same data.</p>
          </article>
          <article class="reveal">
            <span>02</span>
            <h3>Lakehouse brings two worlds together.</h3>
            <p>The flexibility of files and a lake; the structure, transactions, and queries of a warehouse.</p>
          </article>
          <article class="reveal">
            <span>03</span>
            <h3>The report is not the finish line.</h3>
            <p>The goal is traceable, verifiable, reusable data. A dashboard is only one of its consumers.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="route-section section-shell" id="roadmap">
      <div class="section-intro reveal">
        <p class="section-number">05 / RECOMMENDED ROADMAP</p>
        <h2>Learn through evidence,<br /><em>not by the calendar.</em></h2>
      </div>
      <ol class="route-list reveal">
        <li><span>01</span><div><b>Locate the pieces</b><small>Workspace · OneLake · Lakehouse</small></div><em>Mental model</em></li>
        <li><span>02</span><div><b>Move some data</b><small>Manual CSV · Pipeline</small></div><em>Ingestion</em></li>
        <li><span>03</span><div><b>Transform it</b><small>Bronze · Silver · Gold</small></div><em>Spark + SQL</em></li>
        <li><span>04</span><div><b>Model and visualize</b><small>Facts · Dimensions · Measures</small></div><em>Power BI</em></li>
        <li><span>05</span><div><b>Prove it works</b><small>Quality · Lineage · Consumption</small></div><em>Operations</em></li>
      </ol>
    </section>

    <section class="poc-section" id="pocs">
      <div class="section-shell">
        <div class="section-intro light reveal">
          <p class="section-number">06 / PROVE IT WITH A POC</p>
          <h2>Choose a question.<br /><em>Build the evidence.</em></h2>
          <p>A useful POC is small enough to finish, but complete enough to prove a real data journey end to end.</p>
        </div>

        <div class="poc-definition reveal">
          <div>
            <span>START WITH</span>
            <strong>One business question</strong>
          </div>
          <b aria-hidden="true">→</b>
          <div>
            <span>BUILD</span>
            <strong>One traceable flow</strong>
          </div>
          <b aria-hidden="true">→</b>
          <div>
            <span>FINISH WITH</span>
            <strong>One verifiable answer</strong>
          </div>
        </div>

        <div class="poc-grid">
          {pocs.map((poc) => (
            <article class={`poc-card tone-${poc.tone} reveal`}>
              <div class="poc-card-top">
                <span>{poc.number}</span>
                <small>{poc.status}</small>
              </div>
              <h3>{poc.title}</h3>
              <p class="poc-question">“{poc.question}”</p>
              <dl class="poc-meta">
                <div><dt>LEVEL</dt><dd>{poc.level}</dd></div>
                <div><dt>TIMEBOX</dt><dd>{poc.time}</dd></div>
              </dl>
              <div class="poc-flow">
                <span>ARCHITECTURE</span>
                <code>{poc.path}</code>
              </div>
              <details>
                <summary>What this POC proves <span aria-hidden="true">+</span></summary>
                <div class="poc-details">
                  <p><b>You learn</b>{poc.learn}</p>
                  <p><b>Definition of done</b>{poc.proof}</p>
                </div>
              </details>
              {poc.available && (
                <div class="available-row">
                  <p class="available-note"><i></i>{poc.availableCopy || 'Dataset, notebook, and validation SQL included'}</p>
                  <a href={poc.href}>Open the build guide <span aria-hidden="true">→</span></a>
                </div>
              )}
            </article>
          ))}
        </div>

        <aside class="poc-checklist reveal" aria-labelledby="poc-checklist-title">
          <div>
            <p class="panel-kicker">BEFORE CALLING IT DONE</p>
            <h3 id="poc-checklist-title">A demo shows a screen.<br />A POC proves a claim.</h3>
          </div>
          <ul>
            <li><span>01</span>The input and expected output are explicit.</li>
            <li><span>02</span>The run can be repeated without surprises.</li>
            <li><span>03</span>Quality is verified with data, not only visually.</li>
            <li><span>04</span>Limitations and the next experiment are documented.</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="cta-section" id="get-started">
      <div class="cta-shape shape-one"></div><div class="cta-shape shape-two"></div>
      <div class="cta-content reveal">
        <p class="eyebrow light-eye"><span></span> YOUR FIRST GOAL</p>
        <h2>Follow the journey<br />of <em>one row.</em></h2>
        <p>Start with the Sales Lakehouse: three small CSVs, one notebook, one SQL validation, and one answer you can prove.</p>
        <div class="cta-actions">
          <a class="button button-light" href="#pocs">Review the POC <span>↑</span></a>
          <a class="cta-external" href="https://app.fabric.microsoft.com/" target="_blank" rel="noreferrer">Open Microsoft Fabric ↗</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <a class="brand footer-brand" href="/" aria-label="Back to the portfolio"><span class="brand-monogram" aria-hidden="true">MF</span><span>Matías Fernández <em>/ Microsoft Fabric</em></span></a>
    <p class="footer-note">
      <span>From software to data, without losing context.</span>
      <small>Developed with love by Matias Fernandez &amp; GPT-5.6 Sol</small>
    </p>
    <a href="#top">BACK TO TOP ↑</a>
  </footer>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    function activateTab(index: number) {
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
      tabs[index]?.focus();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(index));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        activateTab((index + direction + tabs.length) % tabs.length);
      });
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

    const header = document.querySelector('[data-header]');
    window.addEventListener('scroll', () => header?.classList.toggle('scrolled', window.scrollY > 20), { passive: true });
  </script>
</Layout>
