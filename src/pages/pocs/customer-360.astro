---
import Layout from '../../layouts/Layout.astro';
import '../../styles/guide.css';

const files = [
  { name: 'crm_customers.csv', type: 'CRM', size: '500 B', href: '/downloads/customer-360/data/crm_customers.csv', copy: 'Five governed customers and current attributes.' },
  { name: 'commerce_orders.csv', type: 'ORDERS', size: '600 B', href: '/downloads/customer-360/data/commerce_orders.csv', copy: 'Completed, pending, cancelled, and unmatched purchases.' },
  { name: 'support_tickets.csv', type: 'SUPPORT', size: '500 B', href: '/downloads/customer-360/data/support_tickets.csv', copy: 'Open, closed, matched, and unmatched tickets.' },
  { name: '01_build_customer_360.ipynb', type: 'NOTEBOOK', size: '10 KB', href: '/downloads/customer-360/notebooks/01_build_customer_360.ipynb', copy: 'Identity normalization, star schema, facts, and Customer 360.' },
  { name: 'validations.sql', type: 'SQL', size: '2 KB', href: '/downloads/customer-360/sql/validations.sql', copy: 'Grain, revenue, matches, support, and referential checks.' },
  { name: 'measures.dax', type: 'DAX', size: '1 KB', href: '/downloads/customer-360/semantic-model/measures.dax', copy: 'Explicit reusable measures for the semantic model.' },
  { name: 'kpi_catalog.csv', type: 'GOVERNANCE', size: '1 KB', href: '/downloads/customer-360/semantic-model/kpi_catalog.csv', copy: 'Definition, grain, owner, expected value, and validation.' },
];

const steps = [
  { number: '01', title: 'Define the customer question', time: '15 min', goal: 'Agree on what Customer 360 must answer before joining any data.', theory: 'Customer 360 is not a table with every available column. It is a governed analytical view built for explicit decisions. KPI definition, grain, owner, and validation must be agreed before implementation, or each report will invent a different meaning.', actions: ['Read the KPI catalog included in the kit.', 'Confirm CRM is the customer master for this POC.', 'Define completed revenue, purchasing customer, open ticket, and unmatched record.', 'Create a Lakehouse named lh_customer_360 with Files/raw.'], check: 'You can explain each KPI, its grain, owner, expected value, and exclusion rules.' },
  { number: '02', title: 'Land three source contracts', time: '15 min', goal: 'Preserve CRM, commerce, and support as separate Bronze datasets.', theory: 'Each operational source owns a different grain: one CRM customer, one order, or one support ticket. Bronze preserves those contracts and their lineage. Combining sources before understanding their grain creates accidental duplication and incorrect totals.', actions: ['Upload the three CSV files to Files/raw.', 'Import the notebook and attach lh_customer_360.', 'Run through the Bronze section.', 'Compare identifiers, dates, statuses, and source grains.'], check: 'Three Bronze tables exist and retain their original source identifiers.' },
  { number: '03', title: 'Resolve customer identity', time: '25 min', goal: 'Match source records to the governed CRM customer without hiding exceptions.', theory: 'Entity resolution decides when records from different systems represent the same real-world entity. This POC uses lower(trim(email)) because the rule is deterministic and auditable. Unmatched records are stewardship work, not disposable errors.', actions: ['Run the Silver normalization section.', 'Inspect the normalized email for Ana, Bruno, and Carla.', 'Compare source email with normalized_email.', 'Inspect unmatched_orders and unmatched_tickets.'], check: 'Case and whitespace variants match; one order and one ticket remain visibly unmatched.' },
  { number: '04', title: 'Build the star schema', time: '25 min', goal: 'Separate descriptive customer context from sales and support events.', theory: 'A star schema makes grain and relationships explicit. dim_customer contains one row per customer; fact_sales contains one row per completed order; fact_support contains one row per ticket. Facts share customer_key but are not joined directly to each other.', actions: ['Create dim_customer with a deterministic customer_key.', 'Create fact_sales from completed matched orders.', 'Create fact_support from matched tickets.', 'Confirm every fact key resolves to the dimension.'], check: 'The dimension contains 5 rows, fact_sales contains 5 rows, and no orphan fact keys exist.' },
  { number: '05', title: 'Create the governed 360 view', time: '20 min', goal: 'Aggregate each fact independently and return one trustworthy row per customer.', theory: 'Joining multiple facts before aggregation can multiply rows—for example, two orders times three tickets becomes six rows. Aggregate each fact to customer grain first, then join the aggregates to the dimension. This preserves additive metrics.', actions: ['Aggregate completed sales by customer.', 'Aggregate open tickets by customer.', 'Join both aggregates to dim_customer.', 'Apply the documented value-band business rule.'], check: 'Gold contains five customers; Ana has 1100.00 lifetime value and value band High value.' },
  { number: '06', title: 'Validate and model in Power BI', time: '30–45 min', goal: 'Prove every KPI independently and expose reusable business meaning.', theory: 'The semantic model is the contract between curated data and reports. Explicit DAX measures centralize business rules, while SQL provides an independent control. Agreement between both is stronger evidence than a dashboard that merely looks plausible.', actions: ['Run validations.sql in the SQL analytics endpoint.', 'Create a semantic model with dim_customer, fact_sales, and fact_support.', 'Create one-to-many relationships from the dimension to both facts.', 'Add the included DAX measures and compare them with SQL.', 'Build a customer table plus cards for revenue, customers, and open tickets.'], check: 'SQL and Power BI both show revenue 2350.00, 4 purchasing customers, and 3 open tickets.' },
];

const customerRows = [
  ['Ana Torres', 'Enterprise', '2', '1100.00', '0', 'High value'],
  ['Bruno Silva', 'SMB', '1', '200.00', '1', 'Developing'],
  ['Carla Ruiz', 'SMB', '0', '0.00', '1', 'Developing'],
  ['Diego Lopez', 'Mid-market', '1', '350.00', '0', 'Developing'],
  ['Elena Costa', 'Enterprise', '1', '700.00', '1', 'Established'],
];

const kpis = [
  { name: 'Total Revenue', value: '2350.00', owner: 'Sales Operations', definition: 'Completed, matched order amount.' },
  { name: 'Purchasing Customers', value: '4', owner: 'Customer Analytics', definition: 'Governed customers with a completed order.' },
  { name: 'Open Tickets', value: '3', owner: 'Support Operations', definition: 'Matched support tickets with status Open.' },
  { name: 'Unmatched Revenue', value: '120.00', owner: 'Data Steward', definition: 'Completed revenue not resolved to a customer.' },
];
---

<Layout title="Customer 360 POC — Build guide" description="Build a governed Customer 360 star schema and semantic model in Microsoft Fabric.">
  <header class="guide-header">
    <a class="brand" href="/fabric/" aria-label="Back to the Microsoft Fabric module"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>FABRIC <em>/ POC 03</em></span></a>
    <a class="back-link" href="/fabric/#pocs">← All POCs</a>
  </header>

  <main class="guide-page customer-guide" id="top">
    <section class="guide-hero section-shell">
      <div class="guide-hero-copy">
        <p class="eyebrow"><span></span> READY-TO-BUILD POC · INTERMEDIATE</p>
        <h1>Customer<br /><strong>360.</strong></h1>
        <p class="guide-lede">Resolve identity across CRM, commerce, and support—then build metrics whose meaning is as trustworthy as their totals.</p>
        <div class="guide-actions"><a class="button button-dark" href="/downloads/customer-360-poc.zip" download>Download complete kit <span>↓</span></a><a class="text-link" href="#steps">Start the guide <span>↓</span></a></div>
        <p class="download-note">ZIP · 3 datasets · notebook · SQL · DAX · KPI catalog</p>
      </div>
      <div class="guide-brief" aria-label="POC summary">
        <p>THE QUESTION</p><blockquote>Which customers buy, spend more, or need support?</blockquote>
        <dl><div><dt>TIMEBOX</dt><dd>3–4 hours</dd></div><div><dt>LEVEL</dt><dd>Intermediate</dd></div><div><dt>SOURCES</dt><dd>CRM · sales · support</dd></div><div><dt>PROOF</dt><dd>Governed KPIs</dd></div></dl>
      </div>
    </section>

    <section class="architecture-band"><div class="section-shell architecture-flow" aria-label="POC architecture"><span>3 sources</span><b>→</b><span>Identity</span><b>→</b><span>Dimension</span><b>→</b><span>Facts</span><b>→</b><span>Semantic model</span></div></section>

    <section class="kit-section section-shell" id="kit">
      <div class="guide-section-title"><p class="section-number">01 / YOUR BUILD KIT</p><div><h2>Data, logic,<br /><em>and definitions.</em></h2><p>The kit includes implementation artifacts and the business contract required to judge whether the result is correct.</p></div></div>
      <div class="file-list">{files.map((file, index) => <a class="file-row" href={file.href} download><span class="file-index">0{index + 1}</span><span class="file-type">{file.type}</span><div><strong>{file.name}</strong><small>{file.copy}</small></div><span class="file-size">{file.size}</span><span class="file-download" aria-label={`Download ${file.name}`}>↓</span></a>)}</div>
      <aside class="simulation-note"><span>IDENTITY RULE</span><p>CRM is the governed master. Commerce and support resolve to it through <code>lower(trim(email))</code>. The rule is simple on purpose: every match can be explained and every exception can be inspected.</p></aside>
    </section>

    <section class="steps-section" id="steps"><div class="section-shell">
      <div class="guide-section-title light-title"><p class="section-number">02 / BUILD IT STEP BY STEP</p><div><h2>Match. Model.<br /><em>Define meaning.</em></h2><p>Each stage separates execution instructions, theory to retain, and evidence required to continue.</p></div></div>
      <div class="progress-card" aria-live="polite"><div><span>YOUR PROGRESS</span><strong data-progress-label>0 of 6 stages verified</strong></div><div class="progress-track"><i data-progress-bar></i></div><button type="button" data-reset-progress>Reset</button></div>
      <ol class="build-steps">{steps.map((step, index) => <li class="build-step"><div class="step-rail"><span>{step.number}</span><i></i></div><article><header><div><p>STAGE {step.number}</p><h3>{step.title}</h3></div><span>{step.time}</span></header><p class="step-goal">{step.goal}</p><aside class="theory-note"><span>THEORY TO RETAIN</span><p>{step.theory}</p></aside><ol>{step.actions.map((action) => <li>{action}</li>)}</ol><label class="verify-box"><input type="checkbox" data-step-check={index} /><span><b>Evidence to continue</b>{step.check}</span></label></article></li>)}</ol>
    </div></section>

    <section class="kpi-section section-shell">
      <div class="guide-section-title"><p class="section-number">03 / KPI CONTRACT</p><div><h2>A number needs<br /><em>an accountable meaning.</em></h2><p>Every KPI has an expected value, a business owner, a declared grain, and an independent validation.</p></div></div>
      <div class="kpi-grid">{kpis.map((kpi) => <article><span>{kpi.owner}</span><h3>{kpi.value}</h3><strong>{kpi.name}</strong><p>{kpi.definition}</p></article>)}</div>
    </section>

    <section class="result-section section-shell">
      <div class="guide-section-title"><p class="section-number">04 / EXPECTED CUSTOMER VIEW</p><div><h2>One governed row<br /><em>per customer.</em></h2><p>Unmatched activity stays outside trusted facts until a data steward resolves it.</p></div></div>
      <div class="expected-table-wrap"><table><thead><tr><th>customer</th><th>segment</th><th>orders</th><th>lifetime value</th><th>open tickets</th><th>value band</th></tr></thead><tbody>{customerRows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody><tfoot><tr><td colspan="3">TRUSTED REVENUE</td><td>2350.00</td><td colspan="2">5 GOVERNED CUSTOMERS</td></tr></tfoot></table></div>
      <aside class="customer-proof"><div><span>VISIBLE EXCEPTIONS</span><strong>1 unmatched order · 120.00</strong></div><div><span>VISIBLE EXCEPTIONS</span><strong>1 unmatched support ticket</strong></div><p>Exclusion is acceptable only when it is measurable, explainable, and assigned to an owner.</p></aside>
    </section>

    <section class="help-section"><div class="section-shell help-grid"><div><p class="section-number">05 / IF SOMETHING DOESN’T MATCH</p><h2>Debug identity<br />before metrics.</h2></div><div class="help-list"><details><summary>Ana or Bruno appears twice <span>+</span></summary><p>Confirm matching uses lower(trim(email)) in every source before joining. Source casing and whitespace are deliberately inconsistent.</p></details><details><summary>Revenue shows 2470.00 instead of 2350.00 <span>+</span></summary><p>The unmatched completed order was included. Trusted fact_sales must inner join to dim_customer; unmatched activity belongs in its stewardship table.</p></details><details><summary>Revenue multiplies after adding tickets <span>+</span></summary><p>Do not join fact_sales directly to fact_support. Relate both facts to dim_customer and use explicit measures.</p></details><details><summary>Carla contributes revenue <span>+</span></summary><p>Her order is Pending. fact_sales includes only Completed orders according to the KPI contract.</p></details></div></div></section>

    <section class="guide-cta"><p class="eyebrow light-eye"><span></span> IDENTITY BEFORE INSIGHT</p><h2>Match. Model.<br /><em>Prove.</em></h2><a class="button button-light" href="/downloads/customer-360-poc.zip" download>Get the POC kit <span>↓</span></a></section>
  </main>

  <footer><a class="brand footer-brand" href="/fabric/"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>FABRIC <em>/ FOR BUILDERS</em></span></a><p>POC 03 · CUSTOMER 360</p><a href="#top">BACK TO TOP ↑</a></footer>

  <script>
    const checks = Array.from(document.querySelectorAll<HTMLInputElement>('[data-step-check]'));
    const label = document.querySelector<HTMLElement>('[data-progress-label]'); const bar = document.querySelector<HTMLElement>('[data-progress-bar]'); const storageKey = 'fabric-poc-customer-360-progress';
    function renderProgress() { const completed = checks.filter((check) => check.checked).length; if (label) label.textContent = `${completed} of ${checks.length} stages verified`; if (bar) bar.style.width = `${(completed / checks.length) * 100}%`; localStorage.setItem(storageKey, JSON.stringify(checks.map((check) => check.checked))); }
    try { const saved = JSON.parse(localStorage.getItem(storageKey) || '[]'); checks.forEach((check, index) => { check.checked = Boolean(saved[index]); }); } catch { /* Progress starts empty. */ }
    checks.forEach((check) => check.addEventListener('change', renderProgress)); document.querySelector('[data-reset-progress]')?.addEventListener('click', () => { checks.forEach((check) => { check.checked = false; }); renderProgress(); }); renderProgress();
  </script>
</Layout>
