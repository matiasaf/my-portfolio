---
import Layout from '../../layouts/Layout.astro';
import '../../styles/guide.css';

const files = [
  { name: 'page_001.json', type: 'INITIAL', size: '485 B', href: '/downloads/incremental-api/data/initial/page_001.json', copy: 'First API page with three order events.' },
  { name: 'page_002.json', type: 'INITIAL', size: '331 B', href: '/downloads/incremental-api/data/initial/page_002.json', copy: 'Second API page with two order events.' },
  { name: 'page_003.json', type: 'INCREMENT', size: '332 B', href: '/downloads/incremental-api/data/incremental/page_003.json', copy: 'One updated order and one new order.' },
  { name: '01_incremental_api_ingestion.ipynb', type: 'NOTEBOOK', size: '6 KB', href: '/downloads/incremental-api/notebooks/01_incremental_api_ingestion.ipynb', copy: 'MERGE, latest-record logic, watermark, and run log.' },
  { name: 'validations.sql', type: 'SQL', size: '1 KB', href: '/downloads/incremental-api/sql/validations.sql', copy: 'Idempotency, current-state, Gold, and watermark checks.' },
  { name: 'README.md', type: 'GUIDE', size: '3 KB', href: '/downloads/incremental-api/README.md', copy: 'Portable implementation notes and production extension.' },
  { name: 'REAL_API_E2E.md', type: 'LIVE API', size: '6 KB', href: '/downloads/incremental-api/REAL_API_E2E.md', copy: 'Exact REST connection, pagination, mapping, and three-run configuration.' },
];

const steps = [
  { number: '01', title: 'Prepare the Lakehouse', time: '5 min', goal: 'Create an isolated destination for raw API pages, Delta tables, and run evidence.', theory: 'Incremental ingestion needs both data tables and control state. The Lakehouse holds immutable events, current business state, the watermark, and run history; keeping these artifacts together makes each execution explainable and recoverable.', actions: ['Create or select a Fabric workspace backed by capacity.', 'Create a Lakehouse named lh_api_orders.', 'Create the folder Files/api_source in the Lakehouse explorer.'], check: 'lh_api_orders shows Files/api_source and an empty Tables area.' },
  { number: '02', title: 'Simulate the initial API pages', time: '10 min', goal: 'Land two immutable API responses as the first extraction window.', theory: 'APIs often paginate because a response cannot contain an unlimited dataset. Landing each page unchanged decouples extraction from transformation and makes replay possible. event_id identifies a technical event; order_id identifies the business entity that may change over time.', actions: ['Download and unzip the complete POC kit.', 'Upload only data/initial/page_001.json and page_002.json to Files/api_source.', 'Preview both files: together they contain five unique event_id values.'], check: 'The source folder contains exactly two pages and five JSON records.' },
  { number: '03', title: 'Run the initial load', time: '20 min', goal: 'Create an immutable Bronze event history and the latest state for each order.', theory: 'Bronze uses MERGE on event_id to preserve one copy of every event. Silver uses order_id plus updated_at to derive the latest business state. The watermark records the greatest processed timestamp and becomes the starting boundary for a future incremental request.', actions: ['Import 01_incremental_api_ingestion.ipynb into the workspace.', 'Attach lh_api_orders as the default Lakehouse.', 'Run every cell and refresh the Tables explorer when it finishes.', 'Inspect the run log: new_events_inserted must equal 5.'], check: 'Bronze has 5 events, Silver has 5 orders, and the watermark is 2026-07-01 10:20:00.' },
  { number: '04', title: 'Apply the increment', time: '10 min', goal: 'Process one changed order and one new order without rebuilding the historical event set.', theory: 'Incremental processing distinguishes inserts from updates. A new event for O-1002 does not overwrite its history in Bronze; it becomes the winning version in Silver because its updated_at is newer. This is a simplified change-data-capture pattern.', actions: ['Upload data/incremental/page_003.json into the same Files/api_source folder.', 'Run the notebook again without deleting any table.', 'Inspect O-1002 in Silver: its status must now be Completed.'], check: 'The run inserts 2 events; Bronze has 7 events and Silver has 6 current orders.' },
  { number: '05', title: 'Prove idempotency', time: '5 min', goal: 'Demonstrate that retrying an already successful load is safe.', theory: 'Distributed jobs can retry after timeouts or partial failures, so at-least-once delivery is common. Idempotency means the same input can be processed repeatedly with the same final effect. The immutable event key turns a retry from a duplication risk into a no-op.', actions: ['Run the notebook a third time without uploading or editing any source page.', 'Open api_ingestion_run_log and inspect the latest execution.', 'Confirm that no count, watermark, or Gold result changed.'], check: 'The latest run reports new_events_inserted = 0 while Bronze remains at 7 events.' },
  { number: '06', title: 'Run the deployed API end to end', time: '30 min', goal: 'Replace manual uploads with the deployed HTTPS API and preserve the same evidence.', theory: 'A production pipeline must manage continuation tokens, credentials, retries, and watermark boundaries. The Copy activity unwraps data[], follows next_cursor, and lands JSON Lines; the existing notebook keeps the transformation contract unchanged.', actions: ['Open the Real API end-to-end section below and verify the public health endpoint.', 'Create the REST connection and supply the separately shared API key as x-api-key.', 'Configure QueryParameters.cursor pagination and map the data[] collection.', 'Run initial, increment, and retry windows through Data Factory.', 'Run validations.sql and confirm the same final evidence as the file-based path.'], check: 'The live API path finishes with Bronze 7, Silver 6, completed amount 850.00, and a retry that inserts 0 events.' },
];

const runRows = [
  ['01 · initial', '5', '5', '5', '2026-07-01 10:20'],
  ['02 · increment', '2', '7', '6', '2026-07-02 12:00'],
  ['03 · retry', '0', '7', '6', 'unchanged'],
];

const pipelineRuns = [
  { run: 'Run 1', mode: 'Historical', updatedAfter: 'empty', availableThrough: '2026-07-01T23:59:59Z', expected: '5 events · Bronze 5 · Silver 5' },
  { run: 'Run 2', mode: 'Incremental', updatedAfter: '2026-07-01T10:20:00Z', availableThrough: 'empty', expected: '2 new events · Bronze 7 · Silver 6' },
  { run: 'Run 3', mode: 'Safe retry', updatedAfter: '2026-07-01T10:20:00Z', availableThrough: 'empty', expected: '0 inserts · state unchanged' },
];

const dynamicRelativeUrl = `@concat(
  'api/v1/order-events?limit=2',
  if(
    empty(pipeline().parameters.p_updated_after),
    '',
    concat('&updated_after=', uriComponent(pipeline().parameters.p_updated_after))
  ),
  if(
    empty(pipeline().parameters.p_available_through),
    '',
    concat('&available_through=', uriComponent(pipeline().parameters.p_available_through))
  )
)`;
---

<Layout title="Incremental API POC — Build guide" description="Download and build an idempotent incremental API ingestion proof of concept in Microsoft Fabric.">
  <header class="guide-header">
    <a class="brand" href="/fabric/" aria-label="Back to the Microsoft Fabric module"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>FABRIC <em>/ POC 02</em></span></a>
    <a class="back-link" href="/#pocs">← All POCs</a>
  </header>

  <main class="guide-page api-guide" id="top">
    <section class="guide-hero section-shell">
      <div class="guide-hero-copy">
        <p class="eyebrow"><span></span> READY-TO-BUILD POC · INTERMEDIATE</p>
        <h1>Incremental<br /><strong>API ingestion.</strong></h1>
        <p class="guide-lede">Load new and changed API events, keep the latest business state, and prove that retries create no duplicates.</p>
        <div class="guide-actions">
          <a class="button button-dark" href="/downloads/incremental-api-poc.zip" download>Download complete kit <span>↓</span></a>
          <a class="text-link" href="#steps">Start the guide <span>↓</span></a>
        </div>
        <p class="download-note">ZIP · mock API pages · notebook · validation SQL · README</p>
      </div>
      <div class="guide-brief" aria-label="POC summary">
        <p>THE QUESTION</p><blockquote>Can we update a dataset without reloading—or duplicating—everything?</blockquote>
        <dl><div><dt>TIMEBOX</dt><dd>2–3 hours</dd></div><div><dt>LEVEL</dt><dd>Intermediate</dd></div><div><dt>EXECUTIONS</dt><dd>Initial · delta · retry</dd></div><div><dt>PROOF</dt><dd>0 duplicate events</dd></div></dl>
      </div>
    </section>

    <section class="architecture-band"><div class="section-shell architecture-flow" aria-label="POC architecture"><span>API pages</span><b>→</b><span>Bronze MERGE</span><b>→</b><span>Latest state</span><b>→</b><span>Watermark</span><b>→</b><span>Gold</span></div></section>

    <section class="kit-section section-shell" id="kit">
      <div class="guide-section-title"><p class="section-number">01 / YOUR BUILD KIT</p><div><h2>Two batches.<br /><em>Three executions.</em></h2><p>The JSON pages simulate deterministic API responses, so you can focus on pagination, upserts, watermarks, and safe retries.</p></div></div>
      <div class="file-list">
        {files.map((file, index) => <a class="file-row" href={file.href} download><span class="file-index">0{index + 1}</span><span class="file-type">{file.type}</span><div><strong>{file.name}</strong><small>{file.copy}</small></div><span class="file-size">{file.size}</span><span class="file-download" aria-label={`Download ${file.name}`}>↓</span></a>)}
      </div>
      <aside class="simulation-note"><span>MOCK + LIVE</span><p>Fixed pages keep the first learning path repeatable. The deployed Vercel API now adds a real HTTPS, API-key, cursor-pagination path without changing the Bronze-to-Gold contract.</p></aside>
    </section>

    <section class="steps-section" id="steps"><div class="section-shell">
      <div class="guide-section-title light-title"><p class="section-number">02 / BUILD IT STEP BY STEP</p><div><h2>Load. Change.<br /><em>Retry safely.</em></h2><p>This POC is complete only after the third run proves that the second run can be repeated.</p></div></div>
      <div class="progress-card" aria-live="polite"><div><span>YOUR PROGRESS</span><strong data-progress-label>0 of 6 stages verified</strong></div><div class="progress-track"><i data-progress-bar></i></div><button type="button" data-reset-progress>Reset</button></div>
      <ol class="build-steps">{steps.map((step, index) => <li class="build-step"><div class="step-rail"><span>{step.number}</span><i></i></div><article><header><div><p>STAGE {step.number}</p><h3>{step.title}</h3></div><span>{step.time}</span></header><p class="step-goal">{step.goal}</p><aside class="theory-note"><span>THEORY TO RETAIN</span><p>{step.theory}</p></aside><ol>{step.actions.map((action) => <li>{action}</li>)}</ol><label class="verify-box"><input type="checkbox" data-step-check={index} /><span><b>Evidence to continue</b>{step.check}</span></label></article></li>)}</ol>
    </div></section>

    <section class="live-api-section section-shell" id="real-api">
      <div class="guide-section-title"><p class="section-number">03 / REAL API END-TO-END</p><div><h2>Connect Fabric.<br /><em>Call the live API.</em></h2><p>Use the deployed endpoint to prove the same initial, delta, and retry behavior through a real Data Factory REST connection.</p></div></div>
      <div class="live-api-endpoint">
        <div><span>DEPLOYED · HEALTHY</span><strong>api-alpha-seven-69.vercel.app</strong></div>
        <a href="https://api-alpha-seven-69.vercel.app/api/health" target="_blank" rel="noreferrer">Open health check ↗</a>
      </div>
      <ol class="live-api-steps">
        <li><span>01</span><div><h3>Create the REST connection</h3><p>In Manage connections and gateways, create <code>con_incremental_orders_api</code> with base URL <code>https://api-alpha-seven-69.vercel.app/</code>, REST type, Anonymous authentication, and Organizational privacy.</p></div></li>
        <li><span>02</span><div><h3>Configure authentication</h3><p>In Copy activity → Source → Advanced → Additional headers, add <code>x-api-key</code> with the key shared through the separate secure channel. Never place it in the URL, notebook, or repository.</p></div></li>
        <li><span>03</span><div><h3>Add the pipeline parameters</h3><p>Create two String parameters on <code>pl_incremental_orders_api</code>. They define the lower and upper boundaries of each extraction window.</p><div class="parameter-grid"><div><code>p_updated_after</code><span>Default: empty</span><small>Exclusive lower boundary. Send the last successful watermark to request only newer events.</small></div><div><code>p_available_through</code><span>Default: 2026-07-01T23:59:59Z</span><small>Inclusive upper boundary. It freezes Run 1 so the historical result stays deterministic.</small></div></div></div></li>
        <li><span>04</span><div><h3>Build the dynamic Relative URL</h3><p>Open Copy activity → Source and use this Dynamic content expression. Empty parameters are omitted instead of being sent as blank query-string values.</p><pre class="pipeline-expression"><code>{dynamicRelativeUrl}</code></pre></div></li>
        <li><span>05</span><div><h3>Follow every cursor</h3><p>Add pagination rule <code>QueryParameters.cursor</code> = <code>$.pagination.next_cursor</code>. Fabric sends the opaque token in the next request and stops when the API returns <code>null</code>.</p></div></li>
        <li><span>06</span><div><h3>Unwrap and land the events</h3><p>Set collection reference to <code>$['data']</code>, map the six event fields, and write JSON Lines into <code>lh_api_orders / Files/api_source</code> with a unique filename per pipeline run. The notebook also supports complete response envelopes.</p></div></li>
        <li><span>07</span><div><h3>Execute the three-run proof</h3><p>Run the pipeline and then the notebook for each row. Run 3 intentionally repeats Run 2: identical input must produce an identical final state.</p></div></li>
        <li><span>08</span><div><h3>Validate the final state</h3><p>Run <code>validations.sql</code>. The final proof is Bronze 7, Silver 6, Gold completed amount 850.00, watermark 2026-07-02 12:00, and zero inserts on retry.</p></div></li>
      </ol>

      <div class="pipeline-runbook" aria-labelledby="pipeline-runs-title">
        <div class="pipeline-runbook-head"><span>CONTROLLED EXECUTIONS</span><h3 id="pipeline-runs-title">The same pipeline. Three parameter sets.</h3></div>
        <div class="pipeline-run-table-wrap">
          <table class="pipeline-run-table">
            <thead><tr><th>Execution</th><th>p_updated_after</th><th>p_available_through</th><th>Expected evidence</th></tr></thead>
            <tbody>{pipelineRuns.map((item) => <tr><td><strong>{item.run}</strong><small>{item.mode}</small></td><td><code class:list={{ empty: item.updatedAfter === 'empty' }}>{item.updatedAfter}</code></td><td><code class:list={{ empty: item.availableThrough === 'empty' }}>{item.availableThrough}</code></td><td>{item.expected}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="retry-explainer"><strong>Why Run 3 matters:</strong> API delivery and orchestration can retry. Repeating the incremental request proves that <code>event_id</code> deduplication plus the Bronze <code>MERGE</code> gives exactly-once business effect over at-least-once delivery.</p>
      </div>

      <aside class="e2e-proof">
        <div><span>END-TO-END STATUS</span><h3>API → Fabric → Lakehouse → Notebook is working.</h3></div>
        <ul><li>REST connection</li><li>API key header</li><li>Cursor pagination</li><li>Bronze landing</li><li>Bronze / Silver / Gold</li><li>Watermark</li><li>Gold total 850</li></ul>
      </aside>
      <div class="live-api-download"><div><span>FULL CONFIGURATION</span><p>Includes pipeline parameters, dynamic Relative URL, mapping, output naming, expected evidence, and troubleshooting.</p></div><a class="button button-dark" href="/downloads/incremental-api/REAL_API_E2E.md" download>Download live API guide <span>↓</span></a></div>
    </section>

    <section class="result-section section-shell">
      <div class="guide-section-title"><p class="section-number">04 / EXPECTED EVIDENCE</p><div><h2>The retry is<br /><em>part of the result.</em></h2><p>History grows only for unseen event IDs, while Silver keeps one current row per order.</p></div></div>
      <div class="result-grid"><div class="expected-table-wrap"><table><thead><tr><th>execution</th><th>new events</th><th>bronze</th><th>current orders</th><th>watermark</th></tr></thead><tbody>{runRows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody><tfoot><tr><td colspan="4">COMPLETED ORDERS · 5</td><td>850.00</td></tr></tfoot></table></div><aside class="proof-card"><p>DEFINITION OF DONE</p><ul><li>Seven unique immutable events exist.</li><li>Silver contains six current orders.</li><li>O-1002 is Completed after run 2.</li><li>Run 3 inserts zero events.</li><li>Gold completed amount equals 850.00.</li></ul></aside></div>
    </section>

    <section class="help-section"><div class="section-shell help-grid">
      <div><p class="section-number">05 / IF SOMETHING DOESN’T MATCH</p><h2>Find the broken<br />incremental contract.</h2></div>
      <div class="help-list"><details><summary>The live API returns 401 <span>+</span></summary><p>Add the separately shared key as the x-api-key Additional header. Do not add it to the URL.</p></details><details><summary>Only two API events arrive <span>+</span></summary><p>Configure QueryParameters.cursor = $.pagination.next_cursor. With limit 2, the initial window requires three API requests.</p></details><details><summary>Run 1 reads seven events instead of five <span>+</span></summary><p>For the live path, include available_through=2026-07-01T23:59:59Z. For the file path, page 003 was uploaded too early.</p></details><details><summary>The retry inserts the same events again <span>+</span></summary><p>Confirm that the current notebook deduplicates incoming event_id values and Bronze uses MERGE on event_id.</p></details><details><summary>O-1002 remains Pending <span>+</span></summary><p>Confirm the delta request used updated_after=2026-07-01T10:20:00Z and that Silver ranks by updated_at descending.</p></details></div>
    </div></section>

    <section class="guide-cta"><p class="eyebrow light-eye"><span></span> RUN IT THREE TIMES</p><h2>Load. Update.<br /><em>Retry.</em></h2><a class="button button-light" href="/downloads/incremental-api-poc.zip" download>Get the POC kit <span>↓</span></a></section>
  </main>

  <footer><a class="brand footer-brand" href="/fabric/"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>FABRIC <em>/ FOR BUILDERS</em></span></a><p>POC 02 · INCREMENTAL API</p><a href="#top">BACK TO TOP ↑</a></footer>

  <script>
    const checks = Array.from(document.querySelectorAll<HTMLInputElement>('[data-step-check]'));
    const label = document.querySelector<HTMLElement>('[data-progress-label]');
    const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
    const storageKey = 'fabric-poc-api-progress';
    function renderProgress() { const completed = checks.filter((check) => check.checked).length; if (label) label.textContent = `${completed} of ${checks.length} stages verified`; if (bar) bar.style.width = `${(completed / checks.length) * 100}%`; localStorage.setItem(storageKey, JSON.stringify(checks.map((check) => check.checked))); }
    try { const saved = JSON.parse(localStorage.getItem(storageKey) || '[]'); checks.forEach((check, index) => { check.checked = Boolean(saved[index]); }); } catch { /* Progress starts empty. */ }
    checks.forEach((check) => check.addEventListener('change', renderProgress));
    document.querySelector('[data-reset-progress]')?.addEventListener('click', () => { checks.forEach((check) => { check.checked = false; }); renderProgress(); });
    renderProgress();
  </script>
</Layout>
